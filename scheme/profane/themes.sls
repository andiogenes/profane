;;; (profane themes) — the built-in themes. Unstable API (plan §10).
;;;
;;; profane-light and profane-dark: accessible high-contrast themes in the spirit of
;;; modus-operandi and modus-vivendi-tinted (plan §2), with their own palettes. Body text is
;;; above 7:1 contrast (WCAG AAA), dimmed text and comments above 4.5:1; tests check this.

(library (profane themes)
  (export builtin-themes)
  (import (chezscheme) (profane theme) (profane command) (profane var))

  ;; Shared by both themes; values are points unless noted.
  (define tokens
    '((spacing (xs . 2) (s . 4) (m . 8) (l . 12) (xl . 16) (xxl . 24))
      (radius (s . 4) (m . 6) (l . 10))
      ;; Shadows for raised surfaces (pop-ups, completion): blur, y offset, opacity.
      (elevation (1 (blur . 4) (y . 1) (alpha . 0.12))
                 (2 (blur . 10) (y . 3) (alpha . 0.16))
                 (3 (blur . 20) (y . 6) (alpha . 0.20)))
      ;; Type scale: UI chrome in the system font (SF Pro), code in the code font.
      (type (ui-family . "system-ui") (code-family . "JetBrains Mono") (ui-size . 13)
            (small . 0.9) (title . 1.25))
      (line-height . 1.0)))

  ;; Faces in terms of palette roles (shared; each theme supplies the roles).
  (define faces
    '((default (foreground . fg) (background . bg))
      (cursor (background . cursor))
      (shadow (foreground . fg-dim))
      (line-number (foreground . fg-dim))
      (line-number-current-line (foreground . fg) (weight . bold))
      (hl-line (background . bg-hl-line))
      (highlight (background . bg-highlight))
      (region (background . bg-region))
      (diff-hl-insert (foreground . green))
      (diff-hl-change (foreground . blue))
      (diff-hl-delete (foreground . red))
      (show-paren-match (background . bg-paren-match))
      (show-paren-mismatch (background . bg-paren-mismatch))
      (vertical-border (foreground . border))
      (fringe (foreground . fg-dim))
      (mode-line (foreground . fg) (background . bg-mode-line))
      (mode-line-inactive (foreground . fg-dim) (background . bg-mode-line-inactive))
      (header-line (foreground . fg) (background . bg-mode-line-inactive))
      (mode-line-highlight (background . bg-highlight))
      (tab-bar (foreground . fg-dim) (background . bg-tab-bar))
      (tab-bar-tab (foreground . fg) (background . bg))
      (tab-bar-tab-inactive (foreground . fg-dim) (background . bg-tab-bar))
      (link (foreground . blue) (underline . #t))
      (error (foreground . red) (weight . bold))
      (warning (foreground . yellow) (weight . bold))
      (success (foreground . green) (weight . bold))
      (minibuffer-prompt (foreground . blue) (weight . bold))
      (git-header-label (foreground . fg-dim) (weight . bold))
      (git-branch-local (foreground . blue))
      (git-branch-remote (foreground . green))
      (git-hash (foreground . fg-dim))
      (git-diff-file-heading (foreground . fg) (weight . bold))
      (git-diff-hunk-heading (foreground . cyan))
      (git-diff-added (foreground . green))
      (git-diff-removed (foreground . red))
      (git-diff-added-refined (foreground . green) (background . bg-added-refined) (weight . bold))
      (git-diff-removed-refined (foreground . red) (background . bg-removed-refined) (weight . bold))
      (git-diff-meta (foreground . fg-dim) (slant . italic))
      (git-commit-comment (foreground . fg-dim))
      (ediff-changed-a (background . bg-removed-line))
      (ediff-changed-b (background . bg-added-line))
      (ediff-current-a (background . bg-removed-refined))
      (ediff-current-b (background . bg-added-refined))
      (ediff-refined-a (background . bg-removed-strong) (weight . bold))
      (ediff-refined-b (background . bg-added-strong) (weight . bold))
      (ediff-filler (foreground . bg-hl-line) (background . bg-hl-line))
      (dired-header (foreground . cyan) (weight . bold))
      (dired-directory (foreground . blue) (weight . bold))
      (dired-symlink (foreground . magenta))
      (dired-mark (foreground . red) (weight . bold))
      (dired-marked (foreground . yellow) (weight . bold))
      (dired-flagged (foreground . red))
      (font-lock-comment-face (foreground . fg-dim) (slant . italic))
      (font-lock-doc-face (foreground . fg-dim) (slant . italic))
      (font-lock-string-face (foreground . blue))
      (font-lock-keyword-face (foreground . magenta) (weight . bold))
      (font-lock-builtin-face (foreground . magenta))
      (font-lock-function-name-face (foreground . red))
      (font-lock-variable-name-face (foreground . cyan))
      (font-lock-type-face (foreground . cyan) (weight . bold))
      (font-lock-constant-face (foreground . blue) (weight . bold))))

  (define (theme appearance palette)
    (list (cons 'appearance appearance) (cons 'palette palette) (cons 'tokens tokens)
          (cons 'faces faces)))

  (define builtin-themes
    (begin
      (define-theme 'profane-light
        (theme 'light
               '((bg . "#ffffff") (fg . "#000000") (fg-dim . "#595959") (cursor . fg)
                 (red . "#a10000") (green . "#005f00") (yellow . "#6b5300") (blue . "#0033b0")
                 (magenta . "#7a1b5c") (cyan . "#005a85") (accent . system-accent)
                 (bg-hl-line . "#e8edf3") (bg-highlight . "#d9e6f7") (bg-region . "#c6dbf5")
                 (bg-paren-match . "#b5d3f0") (bg-paren-mismatch . "#f4b9b9")
                 (bg-added-refined . "#bfe6bf") (bg-removed-refined . "#f2c0c0")
                 (bg-added-line . "#e3f3e3") (bg-removed-line . "#fbe3e3")
                 (bg-added-strong . "#8fd18f") (bg-removed-strong . "#e69a9a")
                 (bg-mode-line . "#c9d3e2") (bg-mode-line-inactive . "#eceff4")
                 (bg-tab-bar . "#e1e5ec") (border . "#7d8899")
                 ;; the 16 ANSI colors of terminals
                 (term-black . "#000000") (term-red . red) (term-green . green) (term-yellow . yellow)
                 (term-blue . blue) (term-magenta . magenta) (term-cyan . cyan) (term-white . "#a0a0a0")
                 (term-bright-black . "#595959") (term-bright-red . "#d04040") (term-bright-green . "#2f8f2f")
                 (term-bright-yellow . "#9a7a00") (term-bright-blue . "#3a5fd0") (term-bright-magenta . "#a84c8a")
                 (term-bright-cyan . "#2a82ad") (term-bright-white . "#d0d0d0"))))
      (define-theme 'profane-dark
        (theme 'dark
               '((bg . "#0e1220") (fg . "#ffffff") (fg-dim . "#a3a9b8") (cursor . fg)
                 (red . "#ff8a8f") (green . "#73d673") (yellow . "#e9c75e") (blue . "#86b6ff")
                 (magenta . "#f593e5") (cyan . "#72d9ee") (accent . system-accent)
                 (bg-hl-line . "#1c2336") (bg-highlight . "#26314b") (bg-region . "#2c3b5c")
                 (bg-paren-match . "#31466d") (bg-paren-mismatch . "#6b2b33")
                 (bg-added-refined . "#1f5a2a") (bg-removed-refined . "#6b2b33")
                 (bg-added-line . "#17341f") (bg-removed-line . "#3a1f27")
                 (bg-added-strong . "#2f8a3f") (bg-removed-strong . "#9a3a46")
                 (bg-mode-line . "#2b3654") (bg-mode-line-inactive . "#171c2c")
                 (bg-tab-bar . "#141929") (border . "#5c6888")
                 (term-black . "#555d7a") (term-red . red) (term-green . green) (term-yellow . yellow)
                 (term-blue . blue) (term-magenta . magenta) (term-cyan . cyan) (term-white . "#c8ccd8")
                 (term-bright-black . "#6b7390") (term-bright-red . "#ffb3b6") (term-bright-green . "#a0eaa0")
                 (term-bright-yellow . "#f5df9a") (term-bright-blue . "#b0d0ff") (term-bright-magenta . "#f9c0ef")
                 (term-bright-cyan . "#a0e8f5") (term-bright-white . "#ffffff"))))
      '(profane-light profane-dark)))

  ;; ---- modus-operandi and modus-vivendi-tinted ----
  ;; Palettes copied from Protesilaos Stavrou's modus-themes (modus-themes.el, the operandi and
  ;; vivendi-tinted palettes) under their original names; the profane roles (bg, fg, red, ...) are
  ;; aliases of them. Face assignments follow the modus defaults: no bold or italic syntax, and
  ;; syntax colors from the palette's semantic mappings (keyword, string, fnname, ...).

  (define modus-faces
    (let ([overrides
           '((line-number (foreground . fg-line-number-inactive))
             (line-number-current-line (foreground . fg-line-number-active) (weight . bold))
             (fringe (foreground . fg-dim) (background . fringe))
             (diff-hl-insert (foreground . bg-added-fringe))
             (diff-hl-change (foreground . bg-changed-fringe))
             (diff-hl-delete (foreground . bg-removed-fringe))
             (highlight (background . bg-hover))
             (mode-line (foreground . fg-mode-line-active) (background . bg-mode-line-active))
             (mode-line-inactive (foreground . fg-mode-line-inactive) (background . bg-mode-line-inactive))
             (header-line (foreground . fg) (background . bg-dim))
             (tab-bar (foreground . fg) (background . bg-tab-bar))
             (tab-bar-tab (foreground . fg) (background . bg-tab-current) (weight . bold))
             (tab-bar-tab-inactive (foreground . fg) (background . bg-tab-other))
             (link (foreground . fg-link) (underline . #t))
             (error (foreground . err) (weight . bold))
             (warning (foreground . warning) (weight . bold))
             (success (foreground . info) (weight . bold))
             (minibuffer-prompt (foreground . fg-prompt))
             (git-header-label (foreground . fg-alt) (weight . bold))
             (git-branch-local (foreground . blue-cooler))
             (git-branch-remote (foreground . green-cooler))
             (git-hash (foreground . fg-dim))
             (git-diff-hunk-heading (foreground . fg-alt) (background . bg-active))
             (git-diff-added (foreground . fg-added) (background . bg-added))
             (git-diff-removed (foreground . fg-removed) (background . bg-removed))
             (git-diff-added-refined (foreground . fg-added-intense) (background . bg-added-refine))
             (git-diff-removed-refined (foreground . fg-removed-intense) (background . bg-removed-refine))
             (git-diff-meta (foreground . fg-dim))
             (dired-header (foreground . cyan) (background . bg-cyan-nuanced))
             (dired-directory (foreground . accent-0))
             (dired-symlink (foreground . fg-link-symbolic))
             (dired-mark (foreground . fg-mark-select) (weight . bold))
             (dired-marked (foreground . fg-mark-select) (background . bg-mark-select))
             (dired-flagged (foreground . fg-mark-delete) (background . bg-mark-delete))
             (font-lock-comment-face (foreground . comment))
             (font-lock-doc-face (foreground . docstring))
             (font-lock-string-face (foreground . string))
             (font-lock-keyword-face (foreground . keyword))
             (font-lock-builtin-face (foreground . builtin))
             (font-lock-function-name-face (foreground . fnname))
             (font-lock-variable-name-face (foreground . variable))
             (font-lock-type-face (foreground . type))
             (font-lock-constant-face (foreground . constant)))])
      (map (lambda (f) (or (assq (car f) overrides) f)) faces)))

  ;; The profane roles the shared faces and the canvas read, in terms of modus names.
  (define modus-roles
    '((bg . bg-main) (fg . fg-main) (bg-highlight . bg-hover)
      (bg-added-refined . bg-added-refine) (bg-removed-refined . bg-removed-refine)
      (bg-added-line . bg-added) (bg-removed-line . bg-removed)
      (bg-added-strong . bg-green-intense) (bg-removed-strong . bg-red-intense)
      (bg-paren-mismatch . bg-prominent-err)
      (bg-mode-line . bg-mode-line-active) (accent . system-accent)
      (term-red . red) (term-green . green) (term-yellow . yellow) (term-blue . blue)
      (term-magenta . magenta) (term-cyan . cyan)
      (term-bright-red . red-warmer) (term-bright-green . green-cooler)
      (term-bright-yellow . yellow-warmer) (term-bright-blue . blue-warmer)
      (term-bright-magenta . magenta-cooler) (term-bright-cyan . cyan-cooler)
      (term-black . "#000000") (term-bright-black . "#595959")
      (term-white . "#a6a6a6") (term-bright-white . "#ffffff")))

  (define modus-operandi-palette
    '((fg-dim . "#595959") (fg-alt . "#193668") (bg-dim . "#f2f2f2") (bg-active . "#c4c4c4")
      (bg-inactive . "#e0e0e0") (border . "#9f9f9f") (cursor . "#000000")
      (red . "#a60000") (red-warmer . "#972500") (red-cooler . "#a0132f")
      (green . "#006800") (green-warmer . "#316500") (green-cooler . "#00663f")
      (yellow . "#6f5500") (yellow-warmer . "#884900") (yellow-cooler . "#7a4f2f")
      (blue . "#0031a9") (blue-warmer . "#3548cf") (blue-cooler . "#0000b0")
      (magenta . "#721045") (magenta-warmer . "#8f0075") (magenta-cooler . "#531ab6")
      (cyan . "#005e8b") (cyan-warmer . "#3f578f") (cyan-cooler . "#005f5f")
      (bg-main . "#ffffff") (fg-main . "#000000")
      (bg-cyan-nuanced . "#e0f2fa") (bg-green-intense . "#8adf80") (bg-red-intense . "#ff8f88")
      (bg-hover . "#b2e4dc") (bg-hl-line . "#dae5ec") (bg-region . "#bdbdbd")
      (bg-paren-match . "#5fcfff") (bg-prominent-err . "#ff8f88")
      (bg-mode-line-active . "#c8c8c8") (fg-mode-line-active . "#000000")
      (bg-mode-line-inactive . "#e6e6e6") (fg-mode-line-inactive . "#585858")
      (mode-line-border . "#5a5a5a") (mode-line-border-inactive . "#a3a3a3")
      (bg-tab-bar . "#dfdfdf") (bg-tab-current . "#ffffff") (bg-tab-other . "#c2c2c2")
      (fringe . "#f2f2f2") (fg-line-number-inactive . "#595959") (fg-line-number-active . "#000000")
      (bg-added . "#c1f2d1") (bg-added-refine . "#aee5be") (bg-added-fringe . "#6cc06c")
      (fg-added . "#005000") (fg-added-intense . "#006700")
      (bg-changed-fringe . "#d7c20a")
      (bg-removed . "#ffd8d5") (bg-removed-refine . "#f3b5af") (bg-removed-fringe . "#d84a4f")
      (fg-removed . "#8f1313") (fg-removed-intense . "#aa2222")
      (err . "#a60000") (warning . "#884900") (info . "#005f5f")
      (builtin . "#8f0075") (comment . "#595959") (constant . "#0000b0") (docstring . "#2a5045")
      (fnname . "#721045") (keyword . "#531ab6") (string . "#3548cf") (type . "#005f5f")
      (variable . "#005e8b") (accent-0 . "#0031a9")
      (fg-link . "#3548cf") (fg-link-symbolic . "#005e8b") (fg-prompt . "#005f5f")
      (bg-mark-delete . "#ffcfbf") (fg-mark-delete . "#a60000")
      (bg-mark-select . "#bfefff") (fg-mark-select . "#005e8b")))

  (define modus-vivendi-tinted-palette
    '((fg-dim . "#989898") (fg-alt . "#c6daff") (bg-dim . "#1d2235") (bg-active . "#4a4f69")
      (bg-inactive . "#2b3045") (border . "#61647a") (cursor . "#ff66ff")
      (red . "#ff5f59") (red-warmer . "#ff6b55") (red-cooler . "#ff7f86")
      (green . "#44bc44") (green-warmer . "#75c13e") (green-cooler . "#11c777")
      (yellow . "#d0bc00") (yellow-warmer . "#fec43f") (yellow-cooler . "#dfaf7a")
      (blue . "#2fafff") (blue-warmer . "#79a8ff") (blue-cooler . "#00bcff")
      (magenta . "#feacd0") (magenta-warmer . "#f78fe7") (magenta-cooler . "#b6a0ff")
      (cyan . "#00d3d0") (cyan-warmer . "#4ae2f0") (cyan-cooler . "#6ae4b9")
      (bg-main . "#0d0e1c") (fg-main . "#ffffff")
      (bg-cyan-nuanced . "#042837") (bg-green-intense . "#2f822f") (bg-red-intense . "#9d1f1f")
      (bg-hover . "#45605e") (bg-hl-line . "#303a6f") (bg-region . "#555a66")
      (bg-paren-match . "#4f7f9f") (bg-prominent-err . "#9d1f1f")
      (bg-mode-line-active . "#484d67") (fg-mode-line-active . "#ffffff")
      (bg-mode-line-inactive . "#292d48") (fg-mode-line-inactive . "#969696")
      (mode-line-border . "#979797") (mode-line-border-inactive . "#606270")
      (bg-tab-bar . "#2c3045") (bg-tab-current . "#0d0e1c") (bg-tab-other . "#4a4f6a")
      (fringe . "#1d2235") (fg-line-number-inactive . "#989898") (fg-line-number-active . "#ffffff")
      (bg-added . "#003a2f") (bg-added-refine . "#035542") (bg-added-fringe . "#23884f")
      (fg-added . "#a0e0a0") (fg-added-intense . "#80e080")
      (bg-changed-fringe . "#8f7a30")
      (bg-removed . "#4f1127") (bg-removed-refine . "#781a3a") (bg-removed-fringe . "#b81a26")
      (fg-removed . "#ffbfbf") (fg-removed-intense . "#ff9095")
      (err . "#ff5f59") (warning . "#d0bc00") (info . "#11c777")
      (builtin . "#feacd0") (comment . "#ef8386") (constant . "#b6a0ff") (docstring . "#9ac8e0")
      (fnname . "#f78fe7") (keyword . "#79a8ff") (string . "#2fafff") (type . "#11c777")
      (variable . "#4ae2f0") (accent-0 . "#b6a0ff")
      (fg-link . "#79a8ff") (fg-link-symbolic . "#00d3d0") (fg-prompt . "#4ae2f0")
      (bg-mark-delete . "#620f2a") (fg-mark-delete . "#ff7f86")
      (bg-mark-select . "#004065") (fg-mark-select . "#00d3d0")))

  (define (modus-theme appearance palette)
    (list (cons 'appearance appearance) (cons 'palette (append palette modus-roles))
          (cons 'tokens tokens) (cons 'faces modus-faces)))

  (define modus-themes
    (begin
      (define-theme 'modus-operandi (modus-theme 'light modus-operandi-palette))
      (define-theme 'modus-vivendi-tinted (modus-theme 'dark modus-vivendi-tinted-palette))
      '(modus-operandi modus-vivendi-tinted)))

  (define-command (toggle-theme)
    "Switch between the light and the dark theme."
    (let* ([want (if (and (current-theme) (eq? (theme-appearance (current-theme)) 'dark)) 'light 'dark)]
           [e (assq want (var-ref 'theme-for-appearance))])
      (load-theme (if e (cdr e) (if (eq? want 'dark) 'profane-dark 'profane-light)))
      (message "Theme: ~a" (current-theme))))

  ;; ---- UI style presets (plan §6): which chrome is on. minimal is the default. ----
  ;; The variables are consumed as the chrome lands (mode line and fringes with windows, M2;
  ;; pop-up shadows with canvas pop-ups, M2; scroll bars and motion M4/M8).

  (define ui-styles
    (begin
      (define-ui-style 'minimal
        '((ui-fringe-width . 1) (ui-scroll-bars . #f) (ui-popup-shadow . #f)
          (ui-motion . subtle) (ui-mode-line-style . flat)))
      (define-ui-style 'rich
        '((ui-fringe-width . 8) (ui-scroll-bars . overlay) (ui-popup-shadow . #t)
          (ui-motion . full) (ui-mode-line-style . raised)))
      #t)))
