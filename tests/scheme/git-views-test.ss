(import (chezscheme) (srfi :64) (profane buffer) (profane keymap) (profane command)
        (profane command-loop) (profane async) (profane mode) (profane var) (profane window)
        (profane display) (profane themes) (profane files) (profane minibuffer) (profane complete)
        (profane canvas) (profane transient) (profane tab-bar) (profane simple) (profane section)
        (profane git) (profane git status) (profane git commands) (profane git views))

(for-each invoke-library '((profane simple) (profane window) (profane display) (profane themes)
                           (profane tab-bar) (profane files) (profane minibuffer) (profane complete)
                           (profane canvas) (profane transient) (profane section) (profane git)
                           (profane git status) (profane git commands) (profane git views)))

(test-begin "git-views")

(define (settle!)
  (let loop ([n 0])
    (when (and (command-busy?) (< n 4000))
      (async-poll! 5)
      (resume-busy!)
      (loop (+ n 1)))))
(define (keys . ks) (for-each (lambda (k) (for-each handle-key (kbd k)) (settle!)) ks))
(define (type s) (string-for-each (lambda (c) (handle-text (string c))) s))
(define (text) (buffer-substring 0 (buffer-size)))
(define (contains? s sub)
  (let ([n (string-length sub)])
    (let loop ([i 0])
      (cond [(> (+ i n) (string-length s)) #f]
            [(string=? (substring s i (+ i n)) sub) #t]
            [else (loop (+ i 1))]))))
(define (sh fmt . args) (system (apply format fmt args)))

(define dir (let ([p (format "/tmp/pf-gview-~a" (random 1000000000))])
              (sh "rm -rf ~a; mkdir -p ~a" p p)
              p))
(define (git . args) (sh "cd ~a && git -c user.email=t@t -c user.name=t ~a >/dev/null 2>&1" dir
                         (apply string-append (map (lambda (a) (format "'~a' " a)) args))))
(define (out . args) (cadr (await (run-git dir args))))
(sh "cd ~a && git init -q -b main" dir)
(sh "cd ~a && printf 'one\\ntwo\\nthree\\n' > p.txt && printf 'w\\n' > w.txt" dir)
(git "add" "-A")
(git "commit" "-m" "first commit")
(sh "cd ~a && git mv p.txt renamed.txt && printf 'four\\n' >> renamed.txt" dir)
(git "add" "-A")
(git "commit" "-m" "second: rename and extend")
(git "checkout" "-q" "-b" "side")
(sh "cd ~a && printf 's\\n' > s.txt" dir)
(git "add" "-A")
(git "commit" "-m" "side work")
(git "checkout" "-q" "main")
(sh "cd ~a && sed -i '' 's/^two$/TWO/' renamed.txt && printf 'w  \\n' > w.txt && printf 'n\\n' > staged.txt" dir)
(git "add" "staged.txt")

(define f (select-frame (make-headless-frame 900 700)))
(var-set! 'default-directory (string-append dir "/"))
(keys "C-x g")
(define status (current-buffer))

;; ---- diffs ----
(keys "d" "u")
(test-equal "d u: the unstaged diff buffer" "*git-diff: unstaged*" (buffer-name (current-buffer)))
(test-eq "in git-diff-mode" 'git-diff-mode (var-ref 'major-mode))
(test-assert "lists the files with their status word and hunks"
             (and (contains? (text) "Unstaged changes (2 files)") (contains? (text) "modified   renamed.txt")
                  (contains? (text) "-two") (contains? (text) "+TWO") (contains? (text) "@@ ")))
(test-assert "not the staged file" (not (contains? (text) "staged.txt")))
(let ([hunk-start (let loop ([i 0]) (if (string=? (buffer-substring i (+ i 2)) "@@") i (loop (+ i 1))))])
  (goto-char hunk-start)
  (forward-line 2)
  (keys "RET")
  (test-equal "RET on a hunk line visits the file" "renamed.txt" (buffer-name (current-buffer))))
(switch-to-buffer status)

(keys "d" "s")
(test-assert "d s: the staged diff" (and (contains? (text) "Staged changes (1 file)") (contains? (text) "new file   staged.txt")))
(switch-to-buffer status)
(keys "d" "w")
(test-assert "d w: the work tree against HEAD" (and (contains? (text) "Changes since HEAD (3 files)") (contains? (text) "staged.txt") (contains? (text) "renamed.txt")))
(switch-to-buffer status)

;; whitespace
(keys "d" "u")
(test-assert "a trailing-space change shows" (contains? (text) "modified   w.txt"))
(switch-to-buffer status)
(keys "d" "- w" "u")
(test-assert "-w hides it" (not (contains? (text) "w.txt")))
(switch-to-buffer status)

;; range
(keys "d" "r")
(type "main~1..main")
(keys "RET")
(test-equal "d r: a range" "*git-diff: main~1..main*" (buffer-name (current-buffer)))
(test-assert "shows the rename" (contains? (text) "renamed    p.txt -> renamed.txt"))
(test-assert "and its added line" (contains? (text) "+four"))
(switch-to-buffer status)

;; refresh picks up new changes
(keys "d" "u")
(sh "cd ~a && printf 'more\\n' >> renamed.txt" dir)
(keys "g")
(test-assert "g refreshes a diff buffer" (contains? (text) "+more"))
(keys "TAB")
(switch-to-buffer status)

;; ---- the log ----
(keys "l" "l")
(test-equal "l l: the log of the branch" "*git-log: HEAD*" (buffer-name (current-buffer)))
(test-eq "in git-log-mode" 'git-log-mode (var-ref 'major-mode))
(test-assert "has the commits" (and (contains? (text) "Commits in HEAD (2)") (contains? (text) "first commit")
                                    (contains? (text) "second: rename and extend")))
(test-assert "but not the side branch" (not (contains? (text) "side work")))
(test-assert "with refs" (contains? (text) "(HEAD -> main)"))
(switch-to-buffer status)
(keys "l" "a")
(test-assert "l a: all branches" (and (contains? (text) "Commits in all (3)") (contains? (text) "side work")))
(switch-to-buffer status)
(keys "l" "- n")
(type "1")
(keys "RET")
(keys "l")
(test-assert "-n limits the log" (contains? (text) "Commits in HEAD (1)"))
(keys "+")
(test-assert "+ shows more" (contains? (text) "Commits in HEAD (2)"))
(switch-to-buffer status)
(keys "l" "o")
(type "side")
(keys "RET")
(test-assert "l o: another branch" (and (equal? (buffer-name (current-buffer)) "*git-log: side*") (contains? (text) "side work")))

;; RET on a commit shows it
(goto-char 0)
(keys "n" "RET")
(test-assert "RET on a commit opens it" (contains? (buffer-name (current-buffer)) "*git-commit: "))
(test-assert "with author, date and message" (and (contains? (text) "Author: ") (contains? (text) "Date:   ") (contains? (text) "    side work")))
(test-assert "and its changes" (and (contains? (text) "Changes (1 file)") (contains? (text) "new file   s.txt") (contains? (text) "+s")))

;; from the status buffer
(switch-to-buffer status)
(goto-char (section-start (let ([found #f])
                            (section-walk (sections) (lambda (s) (let ([v (section-value s)])
                                                                   (when (and (not found) v (git-item? v) (eq? (git-item-kind v) 'commit)
                                                                              (contains? (git-commit-subject (git-item-commit v)) "second"))
                                                                     (set! found s)))))
                            found)))
(keys "RET")
(test-assert "RET on a commit in the status buffer" (and (contains? (buffer-name (current-buffer)) "*git-commit: ") (contains? (text) "second: rename and extend")))
(test-assert "a rename in a commit" (contains? (text) "renamed    p.txt -> renamed.txt"))
(switch-to-buffer status)
(goto-char 0)
(keys "d" "c")
(type "HEAD~1")
(keys "RET")
(test-assert "d c asks for a revision" (and (contains? (text) "first commit") (contains? (text) "new file   p.txt")))
(switch-to-buffer status)
(goto-char 0)
(keys "d" "c")
(keys "RET")
(test-assert "and an empty answer means HEAD" (contains? (text) "second: rename and extend"))

;; unknown revision
(switch-to-buffer status)
(goto-char 0)
(keys "d" "c")
(type "no-such-rev")
(keys "RET")
(test-eq "an unknown revision is an error and keeps the buffer" status (current-buffer))
(test-assert "and opens no buffer for it" (not (get-buffer "*git-commit: no-such-rev*")))

;; staging commands do not apply in a diff buffer
(keys "d" "u")
(let ([hunk-start (let loop ([i 0]) (if (string=? (buffer-substring i (+ i 2)) "@@") i (loop (+ i 1))))])
  (goto-char hunk-start))
(keys "s")
(test-equal "s in a diff buffer stages nothing" "staged.txt\n" (out "diff" "--cached" "--name-only"))

(sh "rm -rf ~a" dir)
(delete-headless-frame! f)
(test-end "git-views")
(test-exit)
