(import (chezscheme) (srfi :64) (profane buffer) (profane var) (profane hook) (profane keymap)
        (profane face) (profane command) (profane mode) (profane command-loop) (profane simple))

(invoke-library '(profane simple)) ; registers commands and bindings (see boot.ss)

(test-begin "registry")

;; ---- variables ----
(define-variable 'fill-column 70 "Column for filling.")
(define-variable 'tab-width 8 "Tab stop distance." '(local))
(define a (generate-new-buffer "a"))
(define b (generate-new-buffer "b"))
(set-buffer a)
(test-eqv "default value" 70 (var-ref 'fill-column))
(var-set! 'fill-column 80)
(test-eqv "set without a local changes the default" 80 (with-current-buffer b (var-ref 'fill-column)))
(var-local-set! 'fill-column 100)
(test-eqv "setq-local" 100 (var-ref 'fill-column))
(test-eqv "other buffers keep the default" 80 (with-current-buffer b (var-ref 'fill-column)))
(var-set! 'fill-column 101)
(test-eqv "set changes an existing local" 101 (var-ref 'fill-column))
(test-eqv "default untouched" 80 (var-default 'fill-column))
(var-kill-local! 'fill-column)
(test-eqv "kill-local reverts" 80 (var-ref 'fill-column))
(var-set! 'tab-width 4)
(test-eqv "auto-local var" 4 (var-ref 'tab-width))
(test-eqv "auto-local leaves default" 8 (with-current-buffer b (var-ref 'tab-width)))
(define-variable 'fill-column 1 "redefined")
(test-eqv "redefining keeps the value" 80 (var-ref 'fill-column))
(test-equal "doc updated" "redefined" (variable-documentation 'fill-column))
(test-error "undefined variable" #t (var-ref 'no-such-variable))
(define seen '())
(add-var-watcher! 'tab-width (lambda (n v where) (set! seen (cons (list n v (buffer? where)) seen))))
(var-set! 'tab-width 2)
(test-equal "watcher sees local set" '(tab-width 2 #t) (car seen))
(var-set-default! 'tab-width 3)
(test-equal "watcher sees default set" '(tab-width 3 #f) (car seen))

;; ---- hooks ----
(define-hook 'my-hook)
(define log '())
(define (h1 x) (set! log (cons (list 'h1 x) log)))
(add-hook! 'my-hook (lambda (x) (set! log (cons (list 'proc x) log))))
(add-hook! 'my-hook 'h1 #t)
(add-hook! 'my-hook (lambda (x) (error 'bad "boom")) #t)
(run-hooks 'my-hook 1)
(test-equal "hooks run in order; an error doesn't stop them" '((h1 1) (proc 1)) log)
(set! h1 (lambda (x) (set! log (cons 'redefined log))))
(set! log '())
(run-hooks 'my-hook 2)
(test-assert "symbols are looked up each run" (memq 'redefined log))
(remove-hook! 'my-hook 'h1)
(set! log '())
(run-hooks 'my-hook 3)
(test-equal "remove-hook!" '((proc 3)) log)

;; ---- keymaps ----
(test-equal "kbd canonicalizes" '("C-M-x" "a" "C--") (kbd "M-C-x a C--"))
(define parent (make-keymap))
(define child (make-keymap parent))
(define-key! parent "C-x C-f" 'find-file)
(define-key! parent "C-x k" 'kill-buffer)
(define-key! child "C-x k" 'my-kill)
(define-key! child "C-c" 'child-command)
(test-eq "child binding" 'my-kill (lookup-key child "C-x k"))
(test-eq "parent's C-x bindings still visible" 'find-file (lookup-key child "C-x C-f"))
(test-assert "prefix" (keymap? (lookup-key child "C-x")))
(test-eqv "unbound" #f (lookup-key child "C-x z"))
(test-error "bindings must be names" #t (define-key! child "C-z" (lambda () #f)))
(define-key! child "C-x k" #f)
(test-eq "unbinding exposes the parent" 'kill-buffer (lookup-key child "C-x k"))

;; ---- faces ----
(define-face 'default '((foreground . "#000000") (background . "#ffffff") (family . "Mono")))
(define-face 'shadow '((foreground . "#888888")))
(define-face 'line-number '((inherit . shadow)))
(test-equal "own attribute" "#888888" (face-attribute 'shadow 'foreground))
(test-equal "inherited" "#888888" (face-attribute 'line-number 'foreground))
(test-equal "default fallback" "#ffffff" (face-attribute 'line-number 'background))
(test-eqv "no inheritance asked" #f (face-attribute 'line-number 'foreground #f))
(define changed '())
(add-face-watcher! (lambda (f) (set! changed (cons f changed))))
(set-face-attribute! 'shadow 'foreground "#777777")
(test-equal "theme change visible through inherit" "#777777" (face-attribute 'line-number 'foreground))
(test-eq "watcher notified" 'shadow (car changed))
(define-face 'shadow '((foreground . "#000001")))
(test-equal "redefining keeps theme attributes" "#777777" (face-attribute 'shadow 'foreground))
(test-error "unknown attribute" #t (set-face-attribute! 'shadow 'colour "#000"))

;; ---- modes ----
(define order '())
(define-major-mode text-mode fundamental-mode "Text"
  (set! order (cons 'text order))
  (var-local-set! 'fill-column 72))
(define-major-mode prog-mode #f "Prog" (set! order (cons 'prog order)))
(define-major-mode scheme-mode prog-mode "Scheme" "Scheme source."
  (set! order (cons 'scheme order)))
(add-hook! 'prog-mode-hook (lambda () (set! order (cons 'prog-hook order))))
(add-hook! 'scheme-mode-hook (lambda () (set! order (cons 'scheme-hook order))))
(define-key! (mode-keymap 'prog-mode) "C-c C-c" 'compile-it)
(define-key! (mode-keymap 'scheme-mode) "C-c C-e" 'eval-it)

(set-buffer (generate-new-buffer "src"))
(test-eq "fundamental by default" 'fundamental-mode (major-mode))
(var-local-set! 'fill-column 1)
((command-procedure 'text-mode))
(test-eqv "mode body sets locals after killing old ones" 72 (var-ref 'fill-column))
(set! order '())
(set-major-mode! 'scheme-mode)
(test-equal "bodies root first, then hooks root first" '(prog scheme prog-hook scheme-hook)
            (reverse order))
(test-eqv "major mode change killed text-mode's local" 80 (var-ref 'fill-column))
(test-assert "derived-mode?" (derived-mode? 'scheme-mode 'prog-mode))
(test-eq "mode map" 'eval-it (lookup-key (mode-keymap 'scheme-mode) "C-c C-e"))
(test-eq "inherits parent mode map" 'compile-it (lookup-key (mode-keymap 'scheme-mode) "C-c C-c"))

(define-minor-mode spell-mode ((lighter " Spell"))
  "Buffer-local minor mode."
  (set! order (cons (if (minor-mode-enabled? 'spell-mode) 'spell-on 'spell-off) order)))
(define-key! (mode-keymap 'fundamental-mode) "C-c s" 'fundamental-s)
(set! order '())
(set-minor-mode! 'spell-mode #t)
(test-assert "minor mode on" (minor-mode-enabled? 'spell-mode))
(test-assert "buffer-local by default" (not (with-current-buffer a (minor-mode-enabled? 'spell-mode))))
(test-equal "lighter" " Spell" (mode-lighter 'spell-mode))
((command-procedure 'spell-mode))
(test-equal "command toggles" '(spell-on spell-off) (reverse order))

;; Minor mode keymaps take precedence over the major mode's, which takes precedence over global.
(set-minor-mode! 'spell-mode #t)
(test-equal "precedence: minor, major, global" (list 'spell-mode 'scheme-mode 'global-map)
            (map keymap-name (current-active-maps)))
(set-minor-mode! 'spell-mode #f)
(test-equal "disabled minor map drops out" (list 'scheme-mode 'global-map)
            (map keymap-name (current-active-maps)))

(define-minor-mode global-thing-mode (global))
(set-minor-mode! 'global-thing-mode #t)
(test-assert "global minor mode is on everywhere" (with-current-buffer a (minor-mode-enabled? 'global-thing-mode)))

;; Through the command loop: a mode-local key, a prefix shared with the global map.
(define-command (eval-it) (insert "eval!"))
(handle-key "C-c")
(handle-key "C-e")
(test-equal "mode key via the loop" "eval!" (buffer-string))
(handle-key "C-x")
(handle-key "C-x")
(test-eq "global C-x still reachable" 'exchange-point-and-mark (last-command))

(test-end "registry")
(test-exit)
