(import (chezscheme) (srfi :64) (profane buffer))

(test-begin "buffer")

(define (fresh name) (set-buffer (generate-new-buffer name)))

(define (bytevector-append . bvs)
  (call-with-bytevector-output-port
   (lambda (p) (for-each (lambda (bv) (put-bytevector p bv)) bvs))))

;; ---- basics ----
(fresh "basics")
(test-equal "empty" "" (buffer-string))
(test-eqv "point-min" 0 (point-min))
(test-eqv "point-max empty" 0 (point-max))
(insert "héllo" #\space "wörld")
(test-equal "insert strings and chars" "héllo wörld" (buffer-string))
(test-eqv "point after insert" 11 (point))
(test-eqv "size in characters" 11 (buffer-size))
(goto-char 5)
(insert ",")
(test-equal "insert in middle" "héllo, wörld" (buffer-string))
(test-equal "substring" "wörld" (buffer-substring 7 12))
(test-equal "substring reversed bounds" "wörld" (buffer-substring 12 7))
(test-eqv "char-after" #\é (char-after 1))
(test-eqv "char-before point" #\, (char-before))
(test-eqv "char-after end" #f (char-after 12))
(test-eqv "char-before start" #f (char-before 0))
(delete-region 5 7)
(test-equal "delete-region" "héllowörld" (buffer-string))
(goto-char 0)
(delete-char 2)
(test-equal "delete-char" "llowörld" (buffer-string))
(goto-char 3)
(delete-char -1)
(test-equal "delete-char backward" "llwörld" (buffer-string))
(test-error "delete-char past end" #t (begin (goto-char (point-max)) (delete-char 1)))
(test-error "region out of range" #t (buffer-substring 0 100))
(test-eqv "goto-char clamps" 7 (goto-char 1000))
(test-eqv "goto-char clamps low" 0 (goto-char -5))
(test-error "forward-char past end" #t (forward-char 100))
(test-eqv "forward-char error leaves point at end" 7 (point))
(test-assert "eob?" (eob?))
(goto-char 0)
(test-assert "bob?" (bob?))

;; ---- lines ----
(fresh "lines")
(insert "one\ntwo\n\nfour")
(test-eqv "count-lines" 4 (count-lines 0 (point-max)))
(test-eqv "count-lines ending at bol" 2 (count-lines 0 8))
(goto-char 5)
(test-eqv "line-number-at-pos" 2 (line-number-at-pos))
(test-eqv "line-beginning-position" 4 (line-beginning-position))
(test-eqv "line-end-position" 7 (line-end-position))
(test-eqv "next line start" 8 (line-beginning-position 2))
(test-eqv "previous line end" 3 (line-end-position 0))
(test-assert "not bol" (not (bol?)))
(goto-char 8)
(test-assert "empty line is bol and eol" (and (bol?) (eol?)))
(goto-char 0)
(test-eqv "forward-line" 0 (forward-line 2))
(test-eqv "at line 3" 8 (point))
(test-eqv "forward-line shortfall counts last line" 3 (forward-line 5))
(test-eqv "at end" (point-max) (point))
(test-eqv "forward-line backward shortfall" -2 (begin (goto-char 5) (forward-line -3)))
(test-eqv "at start" 0 (point))
(test-eqv "forward-line 0 goes to bol" 4 (begin (goto-char 6) (forward-line 0) (point)))

;; ---- markers and mark ----
(fresh "markers")
(insert "hello world")
(define m (copy-marker 6))
(define m-adv (copy-marker 6 #t))
(goto-char 6)
(insert "big ")
(test-eqv "marker stays before insertion" 6 (marker-position m))
(test-eqv "advancing marker moves" 10 (marker-position m-adv))
(goto-char 0)
(insert ">")
(test-eqv "markers follow text" 7 (marker-position m))
(set-marker! m 2)
(test-eqv "set-marker!" 2 (marker-position m))
(test-eqv "goto-char accepts markers" 2 (goto-char m))
(delete-marker! m)
(test-eqv "deleted marker points nowhere" #f (marker-position m))
(test-eqv "no mark yet" #f (mark))
(set-mark! 3)
(insert "xx")
(test-eqv "mark is a marker" 5 (mark))

;; ---- undo ----
(fresh "undo")
(insert "abc")
(undo-boundary)
(insert "def")
(test-assert "modified" (buffer-modified?))
(undo)
(test-equal "undo" "abc" (buffer-string))
(test-eqv "undo moves point" 3 (point))
(undo)
(test-equal "undo again" "" (buffer-string))
(test-assert "unmodified after undoing everything" (not (buffer-modified?)))
(test-error "nothing to undo" #t (undo))
(redo)
(redo)
(test-equal "redo" "abcdef" (buffer-string))
(set-buffer-unmodified!)
(test-assert "set-buffer-unmodified!" (not (buffer-modified?)))

;; ---- buffers ----
(define a (get-buffer-create "a"))
(test-eq "get-buffer-create returns existing" a (get-buffer-create "a"))
(test-eq "get-buffer by name" a (get-buffer "a"))
(test-equal "generate-new-buffer uniquifies" "a<2>" (buffer-name (generate-new-buffer "a")))
(with-current-buffer a (insert "in a"))
(test-equal "with-current-buffer" "in a" (with-current-buffer "a" (buffer-string)))
(test-equal "current buffer restored" "undo" (buffer-name (current-buffer)))
(test-assert "buffer-list" (memq a (buffer-list)))
(kill-buffer a)
(test-assert "killed" (not (buffer-live? a)))
(test-eqv "gone from registry" #f (get-buffer "a"))
(test-error "killed buffer refuses edits" #t (with-current-buffer a (insert "x")))

;; ---- files: bytes round-trip, including invalid UTF-8 ----
(define path (format "/tmp/profane-buffer-test-~a.txt" (random 1000000)))
(define raw (bytevector-append (string->utf8 "line 1 — ok\n") #vu8(#xE2 #x61 #xFF #x0A)))
(let ([p (open-file-output-port path (file-options no-fail))])
  (put-bytevector p raw)
  (close-port p))
(define fb (find-file-noselect path))
(test-eq "find-file-noselect reuses visiting buffer" fb (find-file-noselect path))
(set-buffer fb)
(test-equal "raw bytes read as U+FFFD" "line 1 — ok\n\xFFFD;a\xFFFD;\n" (buffer-string))
(test-assert "fresh file unmodified" (not (buffer-modified?)))
(goto-char 0)
(insert ">> ")
(save-buffer)
(define saved
  (let* ([p (open-file-input-port path)] [bv (get-bytevector-all p)]) (close-port p) bv))
(test-equal "save keeps raw bytes intact" (bytevector-append (string->utf8 ">> ") raw) saved)
(test-assert "saved is unmodified" (not (buffer-modified?)))
(delete-file path)

(test-end "buffer")
(test-exit)
