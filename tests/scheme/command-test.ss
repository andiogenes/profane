(import (chezscheme) (srfi :64) (profane buffer) (profane var) (profane mode) (profane keymap) (profane command)
        (profane command-loop) (profane simple))

(invoke-library '(profane simple)) ; registers commands and bindings (see boot.ss)

(test-begin "command")

(define (type s) (string-for-each (lambda (c) (handle-text (string c))) s))
(define (keys . ks) (for-each (lambda (k) (for-each handle-key (kbd k))) ks))

(set-buffer (generate-new-buffer "cmd"))

(type "hello")
(test-equal "typing inserts" "hello" (buffer-string))
(keys "C-b C-b DEL")
(test-equal "motion and backspace" "helo" (buffer-string))
(keys "C-a")
(test-eqv "C-a" 0 (point))
(keys "C-e RET")
(type "second line")

;; "x" / "helo" / "second line": the goal column survives short lines.
(keys "M-<")
(type "x")
(keys "RET M-> <up> <up>")
(test-eqv "clamped to the short line" 1 (point))
(keys "<down> <down>")
(test-eqv "goal column kept" 11 (- (point) (line-beginning-position)))

;; Errors and unbound keys are contained, reported in *Messages*.
(keys "M-< C-b")
(test-eqv "error at buffer start is contained" 0 (point))
(keys "<f12>")
(test-eqv "unbound key" #f (last-command))
(test-equal "reported" "<f12> is undefined" (current-message))

;; ---- prefix keys ----
(keys "C-x")
(test-equal "prefix waits" '("C-x") (pending-keys))
(test-equal "prefix echoed" "C-x-" (current-message))
(keys "C-x")
(test-eq "C-x C-x" 'exchange-point-and-mark (last-command))
(keys "C-x C-g")
(test-equal "C-g cancels a prefix" '() (pending-keys))
(test-equal "quit" "Quit" (current-message))
(keys "C-x C-q")
(test-equal "undefined sequence" "C-x C-q is undefined" (current-message))

;; ---- prefix arguments ----
(set-buffer (generate-new-buffer "args"))
(keys "C-u")
(type "a")
(test-equal "C-u repeats 4 times" "aaaa" (buffer-string))
(keys "C-u C-u")
(type "b")
(test-eqv "C-u C-u: 16" 20 (buffer-size))
(keys "C-u")
(type "12")
(type "c")
(test-eqv "C-u 12" 32 (buffer-size))
(keys "M-3")
(type "d")
(test-eqv "M-3" 35 (buffer-size))
(keys "M-< C-u 3 C-f")
(test-eqv "C-u 3 C-f" 3 (point))
(keys "C-- C-f")
(test-eqv "C-- moves backward" 2 (point))
(type "x")
(test-eqv "argument used up" 36 (buffer-size))

;; ---- typing runs and undo ----
;; Regression: the run of the previous buffer ("x" above) used to continue here, so the first
;; undo took 6 characters.
(set-buffer (generate-new-buffer "amalgamation"))
(type (make-string 25 #\a))
(keys "C-/")
(test-eqv "first undo removes the last 5 typed" 20 (buffer-size))
(keys "C-/")
(test-eqv "then the run of 20" 0 (buffer-size))
(keys "C-?")
(test-eqv "undo-redo" 20 (buffer-size))

;; ---- kill ring ----
(set-buffer (generate-new-buffer "kills"))
(type "one two")
(keys "RET")
(type "three")
(keys "M-< C-k")
(test-equal "kill-line" "\nthree" (buffer-string))
(keys "C-k")
(test-equal "consecutive kills append" "one two\n" (car (kill-ring)))
(keys "C-e C-y")
(test-equal "yank" "threeone two\n" (buffer-string))
(keys "M-< C-SPC C-e M-w")
(test-equal "kill-ring-save copies the region" "threeone two" (car (kill-ring)))

;; ---- live redefinition: keys bind names ----
(define-command (insert-tab) (insert "<tab>"))
(keys "TAB")
(test-assert "redefined command runs" (string=? "<tab>" (buffer-substring (- (point) 5) (point))))
(define-key! (global-map) "C-c t" 'insert-tab)
(keys "C-c t")
(test-eq "two-key binding" 'insert-tab (last-command))

;; ---- the active region (transient-mark-mode) ----
(set-buffer (generate-new-buffer "region"))
(type "one two three")
(define (active?) (var-ref 'mark-active))
(keys "M-<")
(test-assert "not active at first" (not (active?)))
(keys "C-SPC")
(test-assert "C-SPC activates" (active?))
(keys "C-f C-f")
(test-assert "motion keeps it" (active?))
(keys "C-g")
(test-assert "C-g deactivates" (not (active?)))
(test-eqv "the mark stays set" 0 (mark))
(keys "C-SPC C-e")
(keys "M-w")
(test-assert "copying deactivates" (not (active?)))
(keys "C-SPC")
(keys "C-b")
(type "x")
(test-assert "typing deactivates (the buffer changed)" (not (active?)))
(keys "C-SPC C-a")
(keys "C-w")
(test-assert "killing deactivates" (not (active?)))
(keys "C-SPC C-x C-x")
(test-assert "C-x C-x activates" (active?))
(keys "M-< ")
(test-assert "M-< (sets the mark) does not activate by itself"
  (begin (keys "C-g M->") (not (active?))))
(keys "C-SPC")
(set-buffer (generate-new-buffer "region-2"))
(test-assert "per buffer" (not (active?)))

;; ---- electric-pair-mode ----
(set-buffer (generate-new-buffer "pairs"))
(define (typed s) (string-for-each (lambda (c) (handle-text (string c))) s))
(typed "(")
(test-equal "off by default: one character" "(" (buffer-string))
(erase-buffer)
(set-minor-mode! 'electric-pair-mode #t)
(typed "(")
(test-equal "an opener brings its partner" "()" (buffer-string))
(test-eqv "point is between" 1 (point))
(typed "a")
(typed ")")
(test-equal "typing the partner moves over it" "(a)" (buffer-string))
(test-eqv "point is after it" 3 (point))
(erase-buffer)
(typed "[{")
(test-equal "nested" "[{}]" (buffer-string))
(keys "DEL")
(test-equal "DEL between an empty pair deletes both" "[]" (buffer-string))
(typed "x")
(keys "C-b DEL")
(test-equal "DEL elsewhere deletes one character" "x]" (buffer-string))
(erase-buffer)
(typed "\"")
(test-equal "a quote pairs" "\"\"" (buffer-string))
(typed "hi")
(typed "\"")
(test-equal "the closing quote moves over the partner" "\"hi\"" (buffer-string))
(test-eqv "point after it" 4 (point))
(erase-buffer)
(typed "don")
(typed "'")
(test-equal "an apostrophe is not in the pairs here" "don'" (buffer-string))
(erase-buffer)
(typed "word")
(typed "\"")
(test-equal "a quote right after a word does not pair" "word\"" (buffer-string))
(erase-buffer)
(typed "ab")
(goto-char 0)
(typed "(")
(test-equal "an opener before a word character does not pair" "(ab" (buffer-string))
(erase-buffer)
(typed "one two")
(set-mark! 0)
(var-set! 'mark-active #t)
(typed "(")
(test-equal "with the region active the pair goes around it" "(one two)" (buffer-string))
(test-eqv "point stays at the end of the wrapped text" 8 (point))
(test-eqv "and the mark at its start: the region is kept inside" 1 (mark))
(erase-buffer)
(keys "C-u 3")
(typed "(")
(test-equal "a numeric argument inserts plainly" "(((" (buffer-string))
(set-minor-mode! 'electric-pair-mode #f)

;; ---- commands that outlive their slice (engines) ----
(var-set! 'command-slice-ticks 3000)
(define counted 0)
(register-command! 'test-count
  (lambda () (let loop ([i 0]) (set! counted i) (when (< i 60000) (loop (+ i 1))))) "")
(register-command! 'test-spin (lambda () (let loop () (loop))) "")
(define scratch-b (generate-new-buffer "engine-target"))
(define other-b (generate-new-buffer "engine-other"))
(register-command! 'test-wcb
  (lambda () (with-current-buffer other-b (let loop ([i 0]) (when (< i 60000) (loop (+ i 1)))) (insert "x"))) "")
(define-key! (global-map) "<f9>" 'test-count)
(define-key! (global-map) "<f10>" 'test-spin)
(define-key! (global-map) "<f11>" 'test-wcb)
(define (finish!) (let loop ([n 0]) (when (and (command-busy?) (< n 100000)) (resume-busy!) (loop (+ n 1)))))

(set-buffer scratch-b)
(keys "<f9>")
(test-assert "a long command is suspended after its slice" (command-busy?))
(test-assert "partway" (< 0 counted 60000))
(finish!)
(test-assert "and finishes over more slices" (and (not (command-busy?)) (= counted 60000)))
(test-eq "its post-command work ran" 'test-count (last-command))

;; typeahead waits and runs in order, afterwards
(erase-buffer)
(keys "<f9>")
(handle-text "a")
(handle-key "C-f")
(handle-text "b")
(test-equal "nothing is inserted while it runs" "" (buffer-string))
(finish!)
(test-equal "the typeahead ran afterwards, in order" "ab" (buffer-string))

;; C-g aborts and drops the typeahead
(erase-buffer)
(keys "<f10>")
(test-assert "spinning" (command-busy?))
(handle-text "zzz")
(resume-busy!)
(test-assert "still spinning after another slice" (command-busy?))
(handle-key "C-g")
(test-assert "C-g aborts it" (not (command-busy?)))
(test-equal "says so" "Quit" (current-message))
(test-equal "and throws the typeahead away" "" (buffer-string))
(test-eqv "nothing left to resume" #f (begin (resume-busy!) (command-busy?)))
(handle-text "ok")
(test-equal "editing works again" "ok" (buffer-string))

;; with-current-buffer is undone while suspended, and restored on resume
(erase-buffer)
(keys "<f11>")
(test-assert "suspended inside with-current-buffer" (command-busy?))
(test-eq "the current buffer is back to the original meanwhile" scratch-b (current-buffer))
(finish!)
(test-equal "the command inserted into the other buffer when it resumed" "x"
  (with-current-buffer other-b (buffer-string)))
(test-equal "and not here" "" (buffer-string))

;; aborting inside with-current-buffer leaves the original current
(keys "<f11>")
(handle-key "C-g")
(test-eq "abort leaves the buffer alone" scratch-b (current-buffer))

;; ordinary commands never suspend
(var-set! 'command-slice-ticks 500000)
(keys "C-a")
(test-assert "ordinary commands do not" (not (command-busy?)))

;; a mode may bind a plain character: typed text runs the command instead of inserting
(define bound-ran 0)
(register-command! 'test-bound-key (lambda () (set! bound-ran (+ bound-ran 1))) "")
(define-major-mode test-keys-mode fundamental-mode "Keys" "")
(define-key! (mode-keymap 'test-keys-mode) "z" 'test-bound-key)
(define-key! (mode-keymap 'test-keys-mode) "SPC" 'test-bound-key)
(set-buffer (generate-new-buffer "bound"))
(set-major-mode! 'test-keys-mode)
(handle-text "z")
(handle-text " ")
(handle-text "q")
(test-eqv "typed text with a binding runs the command" 2 bound-ran)
(test-equal "and other text is still inserted" "q" (buffer-string))

(test-end "command")
(test-exit)
