(import (chezscheme) (srfi :64) (profane native) (profane buffer) (profane var) (profane keymap)
        (profane command) (profane command-loop) (profane mode) (profane window)
        (profane display) (profane theme) (profane themes) (profane tab-bar)
        (profane minibuffer) (profane complete) (profane simple) (profane isearch))

(for-each invoke-library '((profane simple) (profane window) (profane display) (profane themes)
                           (profane tab-bar) (profane minibuffer) (profane complete)
                           (profane isearch)))
(load-theme 'profane-light)

(test-begin "isearch")

(define (keys . ks) (for-each (lambda (k) (for-each handle-key (kbd k))) ks))
(define (type s) (string-for-each (lambda (c) (handle-text (string c))) s))
(define (hl pos) (get-text-property pos 'highlight))

(define f (select-frame (make-headless-frame 800 600)))
(define w (selected-window))
(define b (get-buffer-create "isearch-text"))
(switch-to-buffer b)
;;              0         1         2         3
;;              0123456789012345678901234567890123456
(insert "foo bar Foo baz\nfood barn\nlast foo\n")
(set-buffer-unmodified!)
(goto-char 0)

;; ---- forward ----
(keys "C-s")
(test-assert "searching" (isearch-active?))
(test-equal "the prompt" "I-search: " (current-message))
(type "fo")
(test-eqv "point after the first match" 2 (point))
(test-equal "the string" "fo" (isearch-string))
(test-equal "the prompt shows it" "I-search: fo" (current-message))
(test-eq "the match is highlighted" 'isearch (hl 0))
(test-eq "other matches too, ignoring case" 'lazy-highlight (hl 8))
(test-eq "on other lines" 'lazy-highlight (hl 16))
(test-eq "not between matches" #f (hl 4))
(test-equal "the buffer is not modified by highlighting" #f (with-current-buffer b (buffer-modified?)))
(type "o")
(test-eqv "the match grows where it is" 3 (point))
(keys "C-s")
(test-eqv "next match (case folded)" 11 (point))
(keys "C-s")
(test-eqv "next line" 19 (point))
(keys "DEL")
(test-eqv "DEL undoes the repeat" 11 (point))
(keys "DEL")
(test-eqv "and the one before" 3 (point))
(test-equal "the string is unchanged by undoing repeats" "foo" (isearch-string))
(keys "DEL")
(test-equal "DEL takes back a character" "fo" (isearch-string))
(keys "RET")
(test-assert "RET stops" (not (isearch-active?)))
(test-eqv "point stays at the match" 2 (point))
(test-eqv "the mark is where the search started" 0 (mark))
(test-eq "highlights are gone" #f (hl 0))
(test-eq "lazy ones too" #f (hl 8))
(test-equal "the string is remembered" '("fo") (search-ring))

;; ---- capitals make it case-sensitive ----
(goto-char 0)
(keys "C-s")
(type "Foo")
(test-eqv "only the capitalized one" 11 (point))
(keys "C-g")
(test-eqv "C-g goes back where it started" 0 (point))
(test-assert "and stops" (not (isearch-active?)))

;; ---- failing, wrapping, C-g taking back the failing part ----
(goto-char 0)
(keys "C-s")
(type "barn")
(test-eqv "found" 25 (point))
(type "xy")
(test-equal "failing" "Failing I-search: barnxy" (current-message))
(test-eqv "point stays at the last match" 25 (point))
(test-eq "the last match stays shown" 'isearch (hl 21))
(keys "C-g")
(test-equal "C-g takes back what fails" "barn" (isearch-string))
(test-assert "still searching" (isearch-active?))
(keys "C-s")
(test-equal "no other match: failing" "Failing I-search: barn" (current-message))
(keys "C-s")
(test-equal "again: wrapped" "Wrapped I-search: barn" (current-message))
(test-eqv "found from the top" 25 (point))
(keys "C-g")
(test-eqv "C-g on a match: back to the start" 0 (point))

;; ---- backward ----
(goto-char (point-max))
(keys "C-r")
(test-equal "backward prompt" "I-search backward: " (current-message))
(type "fo")
(test-eqv "point at the start of the last match" 31 (point))
(type "o")
(test-eqv "grows in place backward too" 31 (point))
(keys "C-r")
(test-eqv "previous" 16 (point))
(keys "C-s")
(test-eqv "turning around: the same match, from its end" 19 (point))
(keys "RET")

;; ---- C-s C-s: the last string again ----
(goto-char 0)
(keys "C-s C-s")
(test-equal "the last string" "foo" (isearch-string))
(test-eqv "found" 3 (point))
(keys "RET")

;; ---- other keys stop searching and then run ----
(goto-char 0)
(keys "C-s")
(type "bar")
(keys "C-f")
(test-assert "C-f stopped the search" (not (isearch-active?)))
(test-eqv "and moved from the match" 8 (point))
(test-eq "highlights are gone" #f (hl 4))
(test-eqv "the mark is where it started" 0 (mark))

(goto-char 0)
(keys "C-s")
(type "bar")
(keys "C-x")
(test-assert "a prefix key stops it" (not (isearch-active?)))
(keys "C-g")

;; ---- C-w adds the word at point ----
(goto-char 0)
(keys "C-s")
(type "ba")
(keys "C-w")
(test-equal "rest of the word" "bar" (isearch-string))
(keys "C-w")
(test-equal "and the next one" "bar Foo" (isearch-string))
(test-eqv "point after it" 11 (point))
(keys "RET")

;; ---- typed text goes to the search even where a mode binds plain keys (dired's n) ----
(define-major-mode letters-mode fundamental-mode "Letters" "Binds n.")
(define-command (letters-n) (insert "N"))
(define-key! (mode-keymap 'letters-mode) "n" 'letters-n)
(set-major-mode! 'letters-mode)
(goto-char 0)
(keys "C-s")
(type "barn")
(test-equal "n was searched for, not run" "barn" (isearch-string))
(test-eqv "found" 25 (point))
(keys "RET")
(test-assert "nothing inserted" (not (with-current-buffer b (buffer-modified?))))
(set-major-mode! 'fundamental-mode)

;; ---- point moved by something else (a mouse click) stops the search ----
(goto-char 0)
(keys "C-s")
(type "foo")
(goto-char 30)
(type "x")
(test-assert "stopped" (not (isearch-active?)))
(test-assert "x was typed as usual" (string=? "x" (buffer-substring 30 31)))
(test-eq "no highlights left" #f (hl 0))
(undo)

;; ---- highlights do not touch faces ----
(put-text-property 0 3 'face 'bold)
(goto-char 0)
(keys "C-s")
(type "foo")
(test-eq "the face is kept under the highlight" 'bold (get-text-property 0 'face))
(keys "RET")
(test-eq "and after" 'bold (get-text-property 0 'face))

(test-end)
(test-exit)
