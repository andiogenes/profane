(import (chezscheme) (srfi :64) (profane buffer) (profane keymap) (profane command)
        (profane command-loop) (profane async) (profane mode) (profane var) (profane window)
        (profane display) (profane themes) (profane files) (profane minibuffer) (profane complete)
        (profane canvas) (profane transient) (profane tab-bar) (profane simple) (profane section)
        (profane git) (profane git status) (profane ediff))

(for-each invoke-library '((profane simple) (profane window) (profane display) (profane themes)
                           (profane tab-bar) (profane files) (profane minibuffer) (profane complete)
                           (profane canvas) (profane transient) (profane section) (profane git)
                           (profane git status) (profane ediff)))

(test-begin "ediff")

(define (settle!)
  (let loop ([n 0])
    (when (and (command-busy?) (< n 4000))
      (async-poll! 5)
      (resume-busy!)
      (loop (+ n 1)))))
(define (keys . ks) (for-each (lambda (k) (for-each handle-key (kbd k)) (settle!)) ks))
(define (type s) (string-for-each (lambda (c) (handle-text (string c))) s))
(define (text-of b) (with-current-buffer b (buffer-substring 0 (buffer-size))))
(define (contains? s sub)
  (let ([n (string-length sub)])
    (let loop ([i 0])
      (cond [(> (+ i n) (string-length s)) #f]
            [(string=? (substring s i (+ i n)) sub) #t]
            [else (loop (+ i 1))]))))
(define (lines-of b) (with-current-buffer b (count-lines 0 (buffer-size))))
(define (sh fmt . args) (system (apply format fmt args)))
(define (line-of-window w) (with-current-buffer (window-buffer w) (save-line w)))
(define (save-line w)
  (let ([p (window-point w)])
    (let loop ([i 0] [n 1]) (cond [(>= i p) n] [(char=? (char-after i) #\newline) (loop (+ i 1) (+ n 1))] [else (loop (+ i 1) n)]))))
(define (face-at-row b row)
  (with-current-buffer b
    (let ([keep (point)])
      (goto-char 0) (forward-line row)
      (let ([face (get-text-property (point) 'face)])
        (goto-char keep)
        face))))

(define f (select-frame (make-headless-frame 1000 600)))
(define home (current-buffer))
(define a (get-buffer-create "left.txt"))
(define b (get-buffer-create "right.txt"))
(with-current-buffer a (insert "one\ntwo\nthree\nfour\nfive\nsix\n"))
(with-current-buffer b (insert "one\ntwo changed\nthree\nfive\nextra\nsix\n"))

(ediff-start a b "left.txt" "right.txt" '())
(define va (get-buffer "*ediff A: left.txt*"))
(define vb (get-buffer "*ediff B: right.txt*"))
(test-assert "view buffers exist" (and va vb))
(test-eqv "two windows side by side" 2 (length (window-list)))
(test-eq "A is selected" va (window-buffer (selected-window)))
(test-assert "A on the left, B on the right"
             (let ([wa (car (window-list))] [wb (cadr (window-list))])
               (and (eq? (window-buffer wa) va) (eq? (window-buffer wb) vb)
                    (< (car (window-edges wa)) (car (window-edges wb))))))
(test-eqv "both views have the same number of rows" (lines-of va) (lines-of vb))
(test-eqv "aligned: 7 rows (one, changed, three, deleted/filler, five, filler/inserted, six)" 7 (lines-of va))
(test-assert "the deleted line is a filler on B's side" (eq? 'ediff-filler (face-at-row vb 3)))
(test-assert "the inserted line is a filler on A's side" (eq? 'ediff-filler (face-at-row va 5)))
(test-assert "the first difference is current: stronger tint" (eq? 'ediff-current-a (face-at-row va 1)))
(test-assert "the other differences are tinted" (eq? 'ediff-changed-a (face-at-row va 3)))
(test-assert "unchanged rows have no face" (not (face-at-row va 0)))
(test-assert "the changed word is emphasized on B (but not the common ones)"
             (with-current-buffer vb
               (goto-char 0) (forward-line 1)
               (let ([p (point)])
                 (and (eq? 'ediff-refined-b (get-text-property (+ p 4) 'face))     ; "changed"
                      (eq? 'ediff-current-b (get-text-property p 'face))))))       ; "two"
(test-eqv "point is on the first difference in both windows" 2 (line-of-window (car (window-list))))
(test-eqv "and in B" 2 (line-of-window (cadr (window-list))))

;; ---- navigation ----
(keys "n")
(test-eqv "n goes to the next difference (row 4)" 4 (line-of-window (car (window-list))))
(test-eqv "in both windows" 4 (line-of-window (cadr (window-list))))
(test-assert "the previous one is no longer current" (eq? 'ediff-changed-a (face-at-row va 1)))
(test-assert "the new one is" (eq? 'ediff-current-a (face-at-row va 3)))
(keys "SPC")
(test-eqv "SPC too" 6 (line-of-window (car (window-list))))
(keys "n")
(test-eqv "at the last difference n stays" 6 (line-of-window (car (window-list))))
(keys "p" "DEL")
(test-eqv "p and DEL go back" 2 (line-of-window (car (window-list))))
(keys "p")
(test-eqv "and stop at the first" 2 (line-of-window (car (window-list))))

;; ---- scrolling together ----
(let ([wa (car (window-list))] [wb (cadr (window-list))])
  (select-window wa)
  (with-current-buffer va (goto-char 0) (forward-line 6))
  (redisplay-prepare!)
  (test-eqv "moving in A moves B's point to the same row" 7 (line-of-window wb))
  (select-window wb)
  (with-current-buffer vb (goto-char 0) (forward-line 2))
  (redisplay-prepare!)
  (test-eqv "and the other way" 3 (line-of-window wa))
  (select-window wa))

;; ---- copying ----
(keys "n" "n")                         ; the insertion: B has "extra", A has nothing
(keys "b")
(test-assert "b copies B's lines into A" (contains? (text-of a) "five\nextra\nsix\n"))
(test-assert "the views were rebuilt without that difference" (not (eq? 'ediff-filler (face-at-row va 5))))
(keys "a")                             ; the deletion is current now: A has "four", B nothing
(test-assert "a copies A's lines into B (re-adding the deleted line)" (contains? (text-of b) "three\nfour\nfive\n"))
(keys "a")                             ; the last difference: "two" against "two changed"
(test-assert "copying a changed line" (contains? (text-of b) "\ntwo\nthree\n"))
(test-assert "now the buffers are equal" (string=? (text-of a) (text-of b)))
(test-assert "undo restores the target" (begin (with-current-buffer b (undo)) (contains? (text-of b) "two changed")))
(keys "!")
(test-assert "! compares again and finds the difference" (contains? (text-of vb) "two changed"))

;; ---- whitespace ----
(with-current-buffer a (erase-buffer) (insert "x\nindented\ny\n"))
(with-current-buffer b (erase-buffer) (insert "x\n    indented\ny\n"))
(keys "!")
(test-assert "whitespace-only changes show" (eq? 'ediff-current-a (face-at-row va 1)))
(keys "#")
(test-assert "# ignores them: no differences left" (not (face-at-row va 1)))
(keys "#")
(test-assert "# again brings them back" (eq? 'ediff-current-a (face-at-row va 1)))

;; ---- quitting ----
(keys "q")
(test-eqv "q leaves one window" 1 (length (window-list)))
(test-assert "and kills the views" (not (or (buffer-live? va) (buffer-live? vb))))
(test-eq "back where we were" home (current-buffer))
(test-assert "the sources are kept" (and (buffer-live? a) (buffer-live? b)))

;; ---- nothing to compare; read-only targets ----
(with-current-buffer b (erase-buffer) (insert (text-of a)))
(ediff-start a b "left.txt" "right.txt" '())
(test-assert "identical buffers open nothing" (and (= 1 (length (window-list))) (not (get-buffer "*ediff A: left.txt*"))))

(define ro (get-buffer-create "readonly.txt"))
(with-current-buffer ro (insert "x\nINDENTED\ny\n") (set-buffer-read-only! #t))
(ediff-start a ro "left.txt" "readonly.txt" '())
(keys "a")
(test-assert "copying into a read-only buffer is refused" (equal? (text-of ro) "x\nINDENTED\ny\n"))
(keys "b")
(test-assert "but out of it is fine" (contains? (text-of a) "INDENTED"))
(keys "q")

;; ---- from the status buffer ----
(define dir (let ([p (format "/tmp/pf-ediff-~a" (random 1000000000))]) (sh "rm -rf ~a; mkdir -p ~a" p p) p))
(define (git . args) (sh "cd ~a && git -c user.email=t@t -c user.name=t ~a >/dev/null 2>&1" dir
                         (apply string-append (map (lambda (x) (format "'~a' " x)) args))))
(sh "cd ~a && git init -q -b main && printf 'one\\ntwo\\nthree\\n' > p.txt && printf 'x\\n' > q.txt" dir)
(git "add" "-A")
(git "commit" "-m" "init")
(sh "cd ~a && printf 'one\\nTWO\\nthree\\n' > p.txt && printf 'x\\ny\\n' > q.txt" dir)
(git "add" "q.txt")
(var-set! 'default-directory (string-append dir "/"))
(keys "C-x g")
(define status (current-buffer))
(define (find-file-section area path)
  (let ([found #f])
    (section-walk (sections) (lambda (s) (let ([v (section-value s)])
                                           (when (and (not found) v (git-item? v) (eq? (git-item-kind v) 'file)
                                                      (eq? (git-item-area v) area) (equal? (git-item-path v) path))
                                             (set! found s)))))
    found))
(goto-char (section-start (find-file-section 'unstaged "p.txt")))
(keys "e")
(test-assert "e on an unstaged file: index against the work tree"
             (and (get-buffer "*ediff A: p.txt (index)*") (get-buffer "*ediff B: p.txt (work tree)*")))
(test-assert "the work tree side is the file" (contains? (text-of (get-buffer "*ediff B: p.txt (work tree)*")) "TWO"))
(keys "a")
(test-equal "a discards the change in the file buffer" "one\ntwo\nthree\n"
            (text-of (get-buffer (string-append "p.txt"))))
(keys "q")
(test-assert "temporary version buffers are gone" (not (get-buffer "p.txt (index)")))
(test-eq "back in the status buffer" status (current-buffer))
(goto-char (section-start (find-file-section 'staged "q.txt")))
(keys "e")
(test-assert "e on a staged file: HEAD against the index"
             (and (get-buffer "*ediff A: q.txt (HEAD)*") (get-buffer "*ediff B: q.txt (index)*")))
(keys "a")
(test-assert "the index side is read-only: nothing changed" (not (contains? (text-of (get-buffer "q.txt (index)")) "x\nx")))
(keys "q")
(goto-char 0)
(keys "e")
(test-eq "e not on a file is an error and opens nothing" status (current-buffer))

(sh "rm -rf ~a" dir)
(delete-headless-frame! f)
(test-end "ediff")
(test-exit)
