(import (chezscheme) (srfi :64) (profane native) (profane buffer) (profane var) (profane keymap)
        (profane command) (profane command-loop) (profane mode) (profane window)
        (profane display) (profane theme) (profane themes) (profane tab-bar)
        (profane minibuffer) (profane complete) (profane simple) (profane files)
        (profane dired) (profane buffer-menu))

(for-each invoke-library '((profane simple) (profane window) (profane display) (profane themes)
                           (profane tab-bar) (profane minibuffer) (profane complete)
                           (profane files) (profane dired) (profane buffer-menu)))
(load-theme 'profane-light)

(test-begin "buffer-menu")

(define (keys . ks) (for-each (lambda (k) (for-each handle-key (kbd k))) ks))
(define (type s) (string-for-each (lambda (c) (handle-text (string c))) s))
(define (contains? s sub)
  (let ([n (string-length sub)])
    (let loop ([i 0]) (cond [(> (+ i n) (string-length s)) #f] [(string=? (substring s i (+ i n)) sub) #t] [else (loop (+ i 1))]))))
(define (lines)
  (let loop ([s (buffer-string)] [cur '()] [out '()])
    (cond [(string=? s "") (reverse (if (null? cur) out (cons (list->string (reverse cur)) out)))]
          [(char=? (string-ref s 0) #\newline) (loop (substring s 1 (string-length s)) '() (cons (list->string (reverse cur)) out))]
          [else (loop (substring s 1 (string-length s)) (cons (string-ref s 0) cur) out)])))
(define (line-of name) (find (lambda (l) (and (> (string-length l) 5) (string=? (substring l 5 (min (string-length l) (+ 5 (string-length name)))) name))) (lines)))
(define (goto-buffer! name)
  (goto-char 0)
  (let loop () (unless (contains? (buffer-substring (line-beginning-position) (line-end-position)) (string-append " " name " ")) (forward-line 1) (loop))))
(define (answer s) (type s) (keys "RET"))
(define (run name) ((command-procedure name)))

(define path (format "/tmp/pf-bm-~a.txt" (time-nanosecond (current-time))))
(call-with-output-file path (lambda (p) (put-string p "disk")) 'replace)

(define f (select-frame (make-headless-frame 800 600)))
(define main (selected-window))
(define alpha (generate-new-buffer "alpha"))
(define beta (generate-new-buffer "beta"))
(define filed (find-file-noselect path))
(define hid (generate-new-buffer " hidden"))
(with-current-buffer beta (insert "unsaved"))
(with-current-buffer filed (insert "edited "))
(with-current-buffer alpha (set-buffer-read-only! #t))
(set-window-buffer! main alpha)

;; ---- the list ----
(run 'buffer-menu)
(test-equal "shown in this window, named" "*Buffer List*" (buffer-name (window-buffer main)))
(test-eq "in buffer-menu-mode" 'buffer-menu-mode (var-ref 'major-mode))
(test-assert "read-only" (buffer-read-only?))
(test-assert "a header" (contains? (car (lines)) "Buffer"))
(test-assert "the buffer we came from is marked current, and read-only" (contains? (substring (line-of "alpha") 0 4) ".%"))
(test-assert "a modified buffer has *" (char=? #\* (string-ref (line-of "beta") 3)))
(test-assert "a file is shown" (contains? (line-of (file-name-nondirectory path)) path))
(test-assert "hidden buffers are left out" (not (exists (lambda (l) (contains? l "hidden")) (lines))))
(test-assert "the list itself is there" (line-of "*Buffer List*"))

;; ---- opening ----
(goto-buffer! "beta")
(keys "RET")
(test-eq "RET shows the buffer here" beta (window-buffer main))
(run 'buffer-menu)
(goto-buffer! "alpha")
(keys "o")
(test-eqv "o shows it in the other window (splitting)" 2 (length (window-list)))
(test-eq "which is selected" alpha (window-buffer (selected-window)))
(delete-window (selected-window))
(select-window main)

;; ---- flags and execution ----
(run 'buffer-menu)
(goto-buffer! "alpha")
(keys "d")
(test-assert "d flags" (char=? #\D (string-ref (line-of "alpha") 0)))
(test-assert "and moves on" (not (contains? (buffer-substring (line-beginning-position) (line-end-position)) " alpha ")))
(goto-buffer! "alpha")
(keys "u")
(test-assert "u unflags" (char=? #\space (string-ref (line-of "alpha") 0)))
(goto-buffer! "alpha")
(keys "d")
(keys "g")
(test-assert "flags survive a refresh" (char=? #\D (string-ref (line-of "alpha") 0)))
(keys "x")
(test-eqv "x kills the flagged buffer" #f (get-buffer "alpha"))
(test-assert "and it is gone from the list" (not (line-of "alpha")))
(test-assert "no confirmation for an unmodified one" (not (minibuffer-active?)))

;; modified buffers ask first
(goto-buffer! "beta")
(keys "k")
(keys "x")
(test-assert "asks about unsaved changes" (minibuffer-active?))
(answer "no")
(test-assert "no: kept" (buffer-live? beta))
(goto-buffer! "beta")
(keys "d")
(keys "x")
(answer "yes")
(test-assert "yes: killed" (not (buffer-live? beta)))

;; save
(goto-buffer! (file-name-nondirectory path))
(keys "s")
(keys "x")
(test-equal "s saves the buffer's file" "edited disk" (call-with-input-file path get-string-all))
(test-assert "now unmodified" (not (with-current-buffer filed (buffer-modified?))))
(keys "x")
(test-equal "nothing flagged" "(No buffers flagged)" (current-message))

;; ---- list-buffers: another window, not selected ----
(keys "q")
(let ([n (length (window-list))])
  (run 'list-buffers)
  (test-eqv "a window was added" (+ n 1) (length (window-list)))
  (test-assert "the list is in it" (exists (lambda (w) (equal? (buffer-name (window-buffer w)) "*Buffer List*")) (window-list)))
  (test-assert "which is not selected" (not (equal? (buffer-name (current-buffer)) "*Buffer List*"))))

(delete-file path)
(test-end "buffer-menu")
(test-exit)
