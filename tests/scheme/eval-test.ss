(import (chezscheme) (srfi :64) (profane native) (profane buffer) (profane var) (profane keymap)
        (profane command) (profane command-loop) (profane mode) (profane window) (profane display)
        (profane theme) (profane themes) (profane tab-bar) (profane minibuffer) (profane complete)
        (profane eval) (profane simple))

(for-each invoke-library '((profane simple) (profane window) (profane display) (profane themes)
                           (profane tab-bar) (profane minibuffer) (profane complete) (profane eval)))
(load-theme 'profane-light)

(test-begin "eval")

(define (keys . ks) (for-each (lambda (k) (for-each handle-key (kbd k))) ks))
(define (type s) (string-for-each (lambda (c) (handle-text (string c))) s))

(define f (select-frame (make-headless-frame 800 600)))

;; ---- eval-string ----
(test-equal "a value" "3" (eval-string "(+ 1 2)"))
(test-equal "several forms, one line each" "1\n2" (eval-string "1 2"))
(test-equal "printed output comes first, void is silent" "hi" (eval-string "(display \"hi\")"))
(test-equal "an error shows its message" "Exception in car: 1 is not a pair" (eval-string "(car 1)"))
(test-equal "a definition persists in the interaction environment" "42"
  (begin (eval-string "(define eval-test-x 42)") (eval-string "eval-test-x")))
(test-equal "an unfinished form is an error" #t
  (let ([r (eval-string "(+ 1")]) (> (string-length r) 0)))

;; ---- the expression before point ----
(define (sexp-before text pos)
  (let-values ([(s e) (last-sexp-bounds text pos)]) (substring text s e)))
(define t "(define (f x) (* x 2)) (f 21) foo 'bar \"a (b\" #\\( ; (comment\n")
(test-equal "after a list" "(define (f x) (* x 2))" (sexp-before t 22))
(test-equal "inside a list: the inner form" "(* x 2)" (sexp-before t 21))
(test-equal "after a list, past a space" "(f 21)" (sexp-before t 29))
(test-equal "an atom" "foo" (sexp-before t 33))
(test-equal "a quoted atom keeps its quote" "'bar" (sexp-before t 38))
(test-equal "a string with a paren in it" "\"a (b\"" (sexp-before t 46))
(test-equal "a character literal that is a paren" "#\\(" (sexp-before t 49))
(test-equal "comments are skipped" "#\\(" (sexp-before t (string-length t)))
(test-equal "a vector keeps its #" "#(1 2)" (sexp-before "x #(1 2)" 8))
(test-equal "brackets" "[a (b)]" (sexp-before "([a (b)]" 8))
(test-assert "nothing before point" (guard (c [else #t]) (sexp-before "   " 3) #f))
(test-assert "just inside an open paren" (guard (c [else #t]) (sexp-before "(a (" 4) #f))

;; ---- the commands ----
(define b (get-buffer-create "scratch-eval"))
(switch-to-buffer b)
(insert "(+ 1 (* 2 3))")
(keys "C-x C-e")
(test-equal "C-x C-e evaluates the form before point" "7" (current-message))
(keys "C-b")
(keys "C-x C-e")
(test-equal "inside a form: the inner one" "6" (current-message))
(erase-buffer)
(insert "(display \"x\") (car 1)")
(keys "C-x C-e")
(test-equal "an error is reported, the editor goes on" "Exception in car: 1 is not a pair" (current-message))

(keys "M-:")
(test-assert "M-: asks" (minibuffer-active?))
(type "(* 6 7)")
(keys "RET")
(test-equal "M-: shows the result" "42" (current-message))
(keys "M-:")
(type "(define eval-test-y 5)")
(keys "RET")
(keys "M-:")
(type "(+ eval-test-y 1)")
(keys "RET")
(test-equal "definitions carry over" "6" (current-message))
(keys "M-:")
(keys "M-p")
(test-equal "M-p recalls the last expression" "(+ eval-test-y 1)" (minibuffer-contents))
(keys "C-g")

(erase-buffer)
(insert "(define eval-test-z 1)\n(set! eval-test-z (+ eval-test-z 1))\neval-test-z")
(keys "M-x")
(type "eval-buffer")
(keys "RET")
(test-equal "eval-buffer: only the last form returns a value" "2" (current-message))
(goto-char 0)
(set-mark! 22)
(eval-string "(set! eval-test-z 10)")
(keys "M-x")
(type "eval-region")
(keys "RET")
(test-equal "eval-region: the define alone" "Evaluated" (current-message))

;; ---- load-file ----
(define script (format "/tmp/pf-load-~a.ss" (time-nanosecond (current-time))))
(call-with-output-file script (lambda (p) (put-string p "(define eval-test-loaded (+ 20 22))\n(display \"loading\")")) 'replace)
(keys "M-x")
(type "load-file")
(keys "RET")
(test-assert "asks for a file" (minibuffer-active?))
(keys "C-a" "C-k") ; drop the proposed directory
(type script)
(keys "RET")
(test-equal "the file was evaluated" "42" (eval-string "eval-test-loaded"))
(test-equal "and said what it printed" "loading" (current-message))
(delete-file script)
(keys "M-x")
(type "load-file")
(keys "RET")
(type "/tmp/pf-no-such-file-xyz.ss")
(keys "RET")
(test-equal "a missing file is reported" "/tmp/pf-no-such-file-xyz.ss does not exist" (current-message))

(delete-headless-frame! f)
(test-end "eval")
(test-exit)
