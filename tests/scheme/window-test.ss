(import (chezscheme) (srfi :64) (profane native) (profane buffer) (profane var) (profane keymap)
        (profane command) (profane command-loop) (profane mode) (profane window)
        (profane display) (profane face) (profane theme) (profane themes) (profane tab-bar)
        (profane transpose-frame) (profane ace-window) (profane mouse) (profane simple))

(for-each invoke-library '((profane simple) (profane window) (profane display) (profane themes)
                           (profane tab-bar) (profane transpose-frame) (profane ace-window)))
(load-theme 'profane-light)

(test-begin "window")

(define (keys . ks) (for-each (lambda (k) (for-each handle-key (kbd k))) ks))
(define (type s) (string-for-each (lambda (c) (handle-text (string c))) s))
(define (edges w) (window-edges w))
(define (contains? s sub)
  (let ([n (string-length s)] [k (string-length sub)])
    (let loop ([i 0])
      (and (<= (+ i k) n) (or (string=? (substring s i (+ i k)) sub) (loop (+ i 1)))))))
(define (y-of w) (cadr (edges w)))
(define (height-of w) (cadddr (edges w)))
(define (width-of w) (caddr (edges w)))

;; A headless frame: the fixed shaper has 10-point cells and 20-point lines.
(define f (select-frame (make-headless-frame 800 600)))
(define w1 (selected-window))
(test-eq "one window" 1 (length (window-list)))
(test-equal "starts on *scratch*" "*scratch*" (buffer-name (window-buffer w1)))
(test-assert "minibuffer window below" (window-minibuffer? (minibuffer-window)))
(test-equal "the window fills the frame above the echo area" '(0.0 0.0 800.0 576.0) (edges w1))


;; ---- mode line border ----
;; A theme with the palette role mode-line-border gives the mode line a 1-pixel top and bottom
;; border (2 points taller); a theme without it keeps it flat.
(define (ml-height) (begin (redisplay-prepare!) (%win-mode-line-height (%window-handle w1))))
(let ([flat (ml-height)])
  (load-theme 'modus-operandi)
  (test-equal "bordered mode line is 2 taller" (+ flat 2.0) (ml-height))
  (load-theme 'modus-vivendi-tinted)
  (test-equal "also in the dark theme" (+ flat 2.0) (ml-height))
  (load-theme 'profane-light)
  (test-equal "flat again without the role" flat (ml-height)))
(load-theme 'modus-operandi)
(test-equal "buffer name: the mode line's background" (face-attribute 'mode-line 'background)
            (face-attribute 'mode-line-buffer-id 'background))
(test-equal "buffer name in other windows: their background"
            (face-attribute 'mode-line-inactive 'background)
            (face-attribute 'mode-line-buffer-id-inactive 'background))
(load-theme 'profane-light)

(define b (get-buffer-create "text"))
(with-current-buffer b
  (let loop ([i 0]) (when (< i 100) (insert (format "line ~a\n" i)) (loop (+ i 1))))
  (goto-char 0))
(switch-to-buffer b)
(test-eq "switch-to-buffer" b (window-buffer w1))
(test-eq "and makes it current" b (current-buffer))

;; ---- splitting, per-window point ----
(goto-char 50)
(keys "C-x 2")
(define w2 (cadr (window-list)))
(test-eqv "C-x 2 makes two windows" 2 (length (window-list)))
(test-eq "the first stays selected" w1 (selected-window))
(test-eq "the new one shows the same buffer" b (window-buffer w2))
(test-eqv "at the same point" 50 (window-point w2))
(test-eqv "stacked" (+ (y-of w1) (height-of w1)) (y-of w2))
(test-eqv "halves" (height-of w1) (height-of w2))

(keys "C-x o")
(test-eq "C-x o selects the other window" w2 (selected-window))
(goto-char 200)
(test-eqv "the old window keeps its point" 50 (window-point w1))
(keys "C-x o")
(test-eqv "selecting it moves the buffer's point back" 50 (point))
(test-eqv "and the other keeps its own" 200 (window-point w2))

;; Regression: plain keys after a prefix reach Scheme as text through the input method; they
;; ran self-insert-command instead of finishing the sequence (C-x 2 inserted "2").
(define size-before (buffer-size))
(handle-key "C-x")
(handle-text "3")
(test-eqv "C-x then text \"3\" splits" 3 (length (window-list)))
(test-eqv "and inserts nothing" size-before (buffer-size))
(define w3 (cadr (window-list)))
(test-eqv "side by side" (+ (car (edges w1)) (width-of w1)) (car (edges w3)))
(test-eqv "same row" (y-of w1) (y-of w3))

;; ---- deleting ----
(select-window w3)
(keys "C-x 0")
(test-eqv "C-x 0" 2 (length (window-list)))
(test-assert "the deleted window is dead" (not (window-live? w3)))
(test-eqv "its space goes back" 800.0 (inexact (width-of w1)))
(test-eq "the most recently used window is selected" w1 (selected-window))
(goto-char 300)
;; Regression: re-selecting after clearing the selection restored the window's stale marker.
(test-error "the sole window cannot be deleted" #t
            (begin (delete-other-windows) (delete-window)))
(test-eqv "C-x 1 (delete-other-windows)" 1 (length (window-list)))
(test-eqv "keeps point" 300 (point))

;; ---- sizes ----
(keys "C-x 2")
(keys "C-x 2")
(let ([ws (window-list)])
  (test-assert "repeated splits halve the selected window"
               (< (height-of (car ws)) (height-of (caddr ws))))
  (keys "C-x +")
  (test-assert "balance-windows evens them out"
               (let ([hs (map height-of (window-list))])
                 (<= (- (apply max hs) (apply min hs)) 1)))
  (let ([h (height-of (car ws))])
    (keys "C-u 2 C-x ^")
    (test-eqv "enlarge-window by 2 lines" (+ h 40) (height-of (car ws)))))
(keys "C-x 1")
(set-window-buffer! (selected-window) b)
(let loop ([i 0]) (when (< i 8) (handle-key "C-x") (handle-key "2") (loop (+ i 1))))
(test-assert "splitting stops at window-min-height" (< (length (window-list)) 9))
(test-assert "with an error message" (string? (current-message)))
(keys "C-x 1")

;; ---- mode lines ----
(let-values ([(text runs) (format-mode-line (selected-window))])
  (test-assert "mode line names the buffer" (contains? text "text"))
  (test-assert "shows the position"
               (contains? text (format "Top  (~a,~a)" (line-number-at-pos)
                                       (- (point) (line-beginning-position)))))
  (test-assert "and the major mode" (contains? text "(Fundamental)"))
  (test-assert "the buffer name in its own face"
               (assq 'mode-line-buffer-id (map (lambda (r) (cons (caddr r) r)) runs))))
(test-assert "frame renders" (> (%frm-redisplay (%frame-handle f)) 0))
(redisplay-prepare!)
(%frm-redisplay (%frame-handle f))
(test-eqv "nothing changed, nothing rendered" -1 (%frm-redisplay (%frame-handle f)))
(with-current-buffer b (insert "x"))
(redisplay-prepare!)
(test-assert "an edit renders again" (> (%frm-redisplay (%frame-handle f)) 0))
(with-current-buffer b (var-set! 'mode-line-format '("custom " (:face bold "line"))))
(let-values ([(text runs) (format-mode-line (selected-window))])
  (test-equal "mode-line-format is buffer-local and taken literally" "custom line" text)
  (test-equal "face runs" '((7 11 bold)) runs))
(with-current-buffer b (var-kill-local! 'mode-line-format))

;; ---- horizontal scrolling ----
(keys "C-x 1")
(define saved-point (point))
(with-current-buffer b
  (goto-char (point-max))
  (insert (make-string 300 #\y)))
(redisplay-prepare!)
(%frm-redisplay (%frame-handle f))
(test-assert "point past the right edge scrolls the window sideways"
             (> (window-hscroll (selected-window)) 0))
(goto-char (line-beginning-position))
(redisplay-prepare!)
(%frm-redisplay (%frame-handle f))
(test-eqv "and back" 0 (window-hscroll (selected-window)))
(keys "C-x <")
(redisplay-prepare!)
(%frm-redisplay (%frame-handle f))
(test-eqv "C-x < scrolls by the window width less two columns" 78 (window-hscroll (selected-window)))
(keys "C-x >")
(redisplay-prepare!)
(%frm-redisplay (%frame-handle f))
(test-eqv "C-x > back" 0 (window-hscroll (selected-window)))
(with-current-buffer b (delete-region (- (point-max) 300) (point-max)))
(goto-char saved-point)

;; ---- the echo area ----
(define (echo-text) (with-current-buffer (window-buffer (minibuffer-window)) (buffer-string)))
(message "hello")
(test-equal "messages show in the echo area" "hello" (echo-text))
(let ([h (height-of (selected-window))])
  (message "one\ntwo\nthree")
  (test-assert "a long message grows the echo area" (< (height-of (selected-window)) h))
  (keys "C-f")
  (test-equal "the next key clears it" "" (echo-text))
  (test-eqv "and it shrinks back" h (height-of (selected-window))))
(keys "C-x")
(test-equal "prefix keys are echoed" "C-x-" (echo-text))
(keys "C-g")
(test-assert "but not logged"
             (not (contains? (with-current-buffer "*Messages*" (buffer-string)) "C-x-")))

;; ---- display modes and killed buffers ----
(keys "C-x 3")
(set-minor-mode! 'display-line-numbers-mode #t)
(test-equal "display modes apply to every window" '(1 1)
            (map (lambda (w) (%win-option (%window-handle w) 1)) (window-list)))
(set-minor-mode! 'display-line-numbers-mode #f)
(set-minor-mode! 'global-hl-line-mode #t)
(define (hl-lines) (map (lambda (w) (%win-option (%window-handle w) 2)) (window-list)))
(test-equal "hl-line only in the selected window" '(1 0) (hl-lines))
(keys "C-x o")
(test-equal "and it follows the selection" '(0 1) (hl-lines))
(var-set! 'global-hl-line-sticky-flag #t)
(test-equal "or everywhere when sticky" '(1 1) (hl-lines))
(var-set! 'global-hl-line-sticky-flag #f)
(set-minor-mode! 'global-hl-line-mode #f)
(keys "C-x o")
(define doomed (get-buffer-create "doomed"))
(set-window-buffer! (cadr (window-list)) doomed)
(kill-buffer doomed)
(redisplay-prepare!)
(test-assert "a window on a killed buffer shows another one"
             (buffer-live? (window-buffer (cadr (window-list)))))

;; ---- text scale is per buffer ----
(keys "C-x C-=")
(test-assert "text scale in this buffer" (> (text-scale) 1.0))
(test-eqv "not in others" 1.0 (with-current-buffer "*scratch*" (text-scale)))
(keys "C-x C-0")

;; ---- tabs ----
(keys "C-x 1 C-x 2")
(define tab1-windows (window-list))
(keys "C-x t 2")
(test-eqv "C-x t 2 opens a tab" 2 (length (tab-list)))
(test-eqv "with one window" 1 (length (window-list)))
(redisplay-prepare!)
(test-assert "the tab bar appears with two tabs" (> (y-of (selected-window)) 0))
(goto-char 123)
(keys "C-x t o")
(goto-char 7)
(keys "C-x t o")
(test-eqv "each tab keeps its point" 123 (point))
(keys "C-x t o")
(test-eqv "both ways" 7 (point))
(test-equal "C-x t o returns to the first layout" tab1-windows (window-list))
(test-assert "whose windows are placed below the tab bar" (> (y-of (car (window-list))) 0))
(keys "C-x t o C-x t 0")
(test-eqv "C-x t 0 closes it" 1 (length (tab-list)))
(test-equal "back on the first layout" tab1-windows (window-list))
(redisplay-prepare!)
(test-eqv "and the tab bar hides again" 0.0 (y-of (car (window-list))))

;; ---- transpose-frame ----
(let ([top (car (window-list))])
  (transpose-frame)
  (test-eqv "transpose-frame: rows become columns" (y-of (car (window-list)))
            (y-of (cadr (window-list))))
  (flop-frame)
  (test-eq "flop-frame swaps left and right" top (cadr (window-list)))
  (transpose-frame)
  (flip-frame))

;; ---- ace-window ----
(define-key! (global-map) "C-c a" 'ace-window)
(keys "C-x 1 C-x 2 C-x 3")
(let ([ws (window-list)])
  (keys "C-c a")
  (test-equal "labels in the mode lines" '(1 2 3) (map window-label ws))
  (type "3")
  (test-eq "a digit picks a window" (caddr ws) (selected-window))
  (test-equal "and the labels go" '(#f #f #f) (map window-label ws))
  (keys "C-c a C-f")
  (test-equal "any other key leaves" '(#f #f #f) (map window-label ws))
  (keys "C-u C-u C-c a")
  (type "1")
  (test-eqv "C-u C-u deletes the picked window" 2 (length (window-list))))
(keys "C-x 1")

;; ---- scrolling by screens, recentering ----
(let ([w (selected-window)] [fh (%frame-handle f)])
  (delete-other-windows)
  (switch-to-buffer (get-buffer-create "screens"))
  (let loop ([i 0]) (when (< i 200) (insert (format "line ~a\n" i)) (loop (+ i 1))))
  (goto-char 0)
  (redisplay-prepare!)
  (%frm-redisplay fh)
  (let* ([body (window-body-lines w)] [page (- body 2)])
    (test-assert "the window shows more than a few lines" (> body 10))
    (keys "C-v")
    (test-eqv "C-v scrolls a screen less two lines of context" page (window-start-line w))
    (test-eqv "point keeps its row (the first)" page (- (line-number-at-pos (point)) 1))
    (keys "C-n C-n")
    (keys "M-v")
    (test-eqv "M-v scrolls back" 0 (window-start-line w))
    (test-eqv "keeping point's row (the third)" 2 (- (line-number-at-pos (point)) 1))
    (keys "M-v")
    (test-eqv "at the top, M-v goes to the start" 0 (point))
    (keys "M-v")
    (test-equal "and then complains" "Exception in scroll-down-command: Beginning of buffer" (current-message))
    (keys "C-u 5 C-v")
    (test-eqv "a numeric argument scrolls that many lines" 5 (window-start-line w))
    ;; the end of the buffer
    (keys "M->")
    (redisplay-prepare!)
    (%frm-redisplay fh)              ; scrolls so that point (the end) is visible
    (keys "C-p C-p C-p")
    (keys "C-v")
    (test-eqv "with the end on screen C-v only moves point there" (point-max) (point))
    (keys "C-v")
    (test-equal "then complains" "Exception in scroll-up-command: End of buffer" (current-message)))
  ;; C-l cycles middle, top, bottom
  (goto-char 0)
  (set-window-start-line! w 0)
  (keys "C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n C-n")
  (redisplay-prepare!)
  (let ([line (- (line-number-at-pos (point)) 1)] [body (window-body-lines w)])
    (keys "C-l")
    (test-eqv "C-l: point's line in the middle" (- line (quotient body 2)) (window-start-line w))
    (keys "C-l")
    (test-eqv "again: at the top" line (window-start-line w))
    (keys "C-l")
    (test-eqv "again: at the bottom" (- line (- body 1)) (window-start-line w))
    (keys "C-l")
    (test-eqv "and around" (- line (quotient body 2)) (window-start-line w))))

;; ---- per-window buffer history ----
(let* ([w (selected-window)] [a (get-buffer-create "hist-a")] [b2 (get-buffer-create "hist-b")]
       [c (get-buffer-create "hist-c")])
  (switch-to-buffer a) (switch-to-buffer b2) (switch-to-buffer c)
  (test-eq "history is most recent first" b2 (car (window-prev-buffers w)))
  (keys "M-[")  ; not bound here: init.ss is not loaded
  (command-procedure 'previous-buffer)
  ((command-procedure 'previous-buffer))
  (test-eq "previous-buffer goes back through this window's history" b2 (window-buffer w))
  ((command-procedure 'previous-buffer))
  (test-eq "again" a (window-buffer w))
  ((command-procedure 'next-buffer))
  (test-eq "next-buffer goes forward again" b2 (window-buffer w))
  (switch-to-buffer a)
  (test-equal "a new switch drops the forward list" '() (window-next-buffers w))
  (kill-buffer c)
  (test-assert "killed buffers leave the history" (not (memq c (window-prev-buffers w))))
  ;; two windows keep their own
  (split-window w)
  (let ([w2 (cadr (window-list))])
    (let ([before (window-prev-buffers w)])
      (set-window-buffer! w2 b2)
      (test-equal "another window's switch does not touch this one's history" before
        (window-prev-buffers w)))))

;; ---- the header line ----
(let ([fh (%frame-handle f)] [w (selected-window)])
  (delete-other-windows)
  (switch-to-buffer (get-buffer-create "headed"))
  (insert "text\nmore")
  (goto-char 0)
  (redisplay-prepare!)
  (%frm-redisplay fh)
  (test-eqv "no header line by default" 0.0 (%win-header-line-height (%window-handle w)))
  (let ([before (window-body-lines w)] [rect-before (window-pos-rect w 0)])
    (var-set! 'header-line-format '(" header: " mode-line-buffer-identification))
    (redisplay-prepare!)
    (%frm-redisplay fh)
    (let ([hh (%win-header-line-height (%window-handle w))])
      (test-assert "a header line has a height" (> hh 0))
      (test-eqv "the text moved down by it" (+ (cadr rect-before) hh) (cadr (window-pos-rect w 0)))
      (test-assert "fewer lines fit" (<= (window-body-lines w) before))
      (test-eqv "clicking the first text line still reaches position 0"
                0 (%win-pos-at (%window-handle w) 5.0 (+ hh 5.0)))
      (let ([start (point)])
        (handle-mouse 'down 50.0 (/ hh 2) 1)
        (test-eqv "clicking the header itself does not move point" start (point))))
    (var-set! 'header-line-format #f)
    (redisplay-prepare!)
    (%frm-redisplay fh)
    (test-eqv "removed again" 0.0 (%win-header-line-height (%window-handle w)))
    (test-equal "text back where it was" rect-before (window-pos-rect w 0))))

;; ---- the active region shows in the selected window only ----
(let ([fh (%frame-handle f)] [w (selected-window)])
  (delete-other-windows)
  (switch-to-buffer (get-buffer-create "region-view"))
  (insert "alpha beta gamma")
  (goto-char 0)
  (redisplay-prepare!)
  (%frm-redisplay fh)
  (goto-char 11)
  (set-mark! 6)
  (redisplay-prepare!)
  (let ([plain (%frm-redisplay fh)])
    (var-set! 'mark-active #t)
    (redisplay-prepare!)
    (test-eqv "the region adds one rectangle" (+ plain 1) (%frm-redisplay fh))
    (var-set! 'mark-active #f)
    (redisplay-prepare!)
    (test-eqv "and deactivating removes it" plain (%frm-redisplay fh))))

;; ---- native-view windows ----
(let* ([fh (%frame-handle f)] [ws (window-list)] [w (car ws)])
  (test-eqv "no native windows" 0 (%frm-native-count fh))
  (test-eq "kinds" 'stub (car (native-view-kinds)))
  (set-window-native! w 'stub)
  (test-eq "the kind is remembered" 'stub (window-native w))
  (test-eqv "one native window" 1 (%frm-native-count fh))
  (test-eqv "kind number" 1.0 (%frm-native-field fh 0 5))
  (test-eqv "its body is the window less the mode line"
            (- (height-of w) (%win-mode-line-height (%window-handle w)))
            (%frm-native-field fh 0 3))
  (test-assert "an unknown kind is an error" (guard (c [else #t]) (set-window-native! w 'nope) #f))
  (test-assert "not for the minibuffer"
    (guard (c [else #t]) (set-window-native! (minibuffer-window) 'stub) #f))
  (let ([before (%frm-native-field fh 0 3)])
    (split-window w)
    (test-eqv "still one" 1 (%frm-native-count fh))
    (test-assert "it was resized with the split" (< (%frm-native-field fh 0 3) before)))
  (set-window-native! w #f)
  (test-eq "text again" #f (window-native w))
  (test-eqv "none" 0 (%frm-native-count fh)))

;; ---- per-buffer line numbers, side windows, dedicated windows ----
(keys "C-x 1")
(set-minor-mode! 'display-line-numbers-mode #t)
(define plain (get-buffer-create "plain"))
(define quiet (get-buffer-create "quiet"))
(with-current-buffer quiet (var-set! 'display-line-numbers #f))
(switch-to-buffer plain)
(test-eqv "a buffer shows line numbers" 1 (%win-option (%window-handle (selected-window)) 1))
(switch-to-buffer quiet)
(test-eqv "unless it opts out (checked when the window gets the buffer)" 0 (%win-option (%window-handle (selected-window)) 1))
(switch-to-buffer plain)
(test-eqv "and back" 1 (%win-option (%window-handle (selected-window)) 1))
(let ([echo (window-buffer (minibuffer-window))])
  (set-window-buffer! (minibuffer-window) plain)
  (test-eqv "the minibuffer window never has line numbers" 0
            (%win-option (%window-handle (minibuffer-window)) 1))
  (set-window-buffer! (minibuffer-window) echo))
(set-minor-mode! 'display-line-numbers-mode #f)

(define main (selected-window))
(define side (add-side-window (selected-frame) quiet 'left 20))
(test-equal "a side window takes the left edge, full height" '(0.0 0.0 200.0 576.0) (window-edges side))
(test-equal "the old window keeps the rest" '(200.0 0.0 600.0 576.0) (window-edges main))
(test-eq "the side window is first" side (car (window-list)))
(test-eq "the selection is unchanged" main (selected-window))

(set-window-dedicated! side #t)
(test-assert "dedicated" (window-dedicated? side))
(select-window side)
(switch-to-buffer plain)
(test-eq "switch-to-buffer in a dedicated window goes to another" main (selected-window))
(test-eq "the other window got it" plain (window-buffer main))
(test-eq "the dedicated window kept its buffer" quiet (window-buffer side))

;; with the main window split below, the side window still spans the height
(select-window main)
(define lower (split-window main 'below))
(test-equal "side windows span the height of the frame" 576.0 (cadddr (window-edges side)))
(define side2 (add-side-window (selected-frame) quiet 'right 10))
(test-equal "a right side window" 100.0 (caddr (window-edges side2)))
(test-equal "at the right edge" 700.0 (car (window-edges side2)))
(delete-window side2)
(delete-window lower)

;; the other window: split when alone, else the most recent one
(set-window-dedicated! side #f)
(delete-window side)
(test-eq "one window again" 1 (length (window-list)))
(define shown (display-buffer-in-other-window quiet))
(test-eq "splits when alone" 2 (length (window-list)))
(test-eq "shows the buffer there" quiet (window-buffer shown))
(test-eq "without selecting it" main (selected-window))
(test-eq "reuses it next time" shown (display-buffer-in-other-window plain #t))
(test-eq "and can select it" shown (selected-window))

(delete-headless-frame! f)
(test-end "window")
(test-exit)
